{
  "name": "nokhodchi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "نخودچی — Persian calorie, macro and activity tracker (installable PWA + small sync server)",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning server/index.js",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "icons": "node scripts/make-icons.mjs",
    "admin": "node --disable-warning=ExperimentalWarning server/admin.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource/lalezar": "^5.3.0",
    "lucide-react": "^1.57.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
