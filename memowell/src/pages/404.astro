---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getSite, href } from '../lib/content.js';
const ui = getSite('en').data.ui;
---
<Base locale="en" routePath="/404" title={`${ui.not_found_title} | Memowell`} noindex>
  <PageHead locale="en" title={ui.not_found_title} body={ui.not_found_body}>
    <div class="btn-row"><a class="btn btn--light" href={href('en', '/')}>{ui.home}</a></div>
  </PageHead>
</Base>
