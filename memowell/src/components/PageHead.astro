---
// Inner-page opening: breadcrumb, H1 and the approved intro copy. Optional media slot on the side.
import { getSite, href, md } from '../lib/content.js';

interface Props { locale: string; title: string; body?: string; crumbs?: { label: string; href: string }[]; note?: string; wide?: boolean }
const { locale, title, body, crumbs = [], note, wide = false } = Astro.props;
const ui = getSite(locale).data.ui;
const hasMedia = Astro.slots.has('media');
---
<header class:list={['page-head', { 'page-head--media': hasMedia }]}>
  <div class="wrap page-head__grid">
    <div class="page-head__copy">
      {crumbs.length > 0 && (
        <nav class="breadcrumb" aria-label={ui.breadcrumb}>
          <ol>
            <li><a href={href(locale, '/')}>{ui.home}</a></li>
            {crumbs.map((c) => <li><a href={href(locale, c.href)}>{c.label}</a></li>)}
          </ol>
        </nav>
      )}
      {note && <p class="page-head__note">{note}</p>}
      <h1 class:list={{ 'page-head__wide': wide }}>{title}</h1>
      {body && <div class="lead page-head__lead flow" set:html={md(body)} />}
      <slot />
    </div>
    {hasMedia && <div class="page-head__media"><slot name="media" /></div>}
  </div>
</header>

<style>
  .page-head__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); align-items: center; }
  .page-head__copy { grid-column: 1 / span 8; }
  .page-head--media .page-head__copy { grid-column: 1 / span 7; }
  .page-head__media { grid-column: 8 / span 5; position: relative; }
  .page-head h1 { max-width: 18ch; }
  .page-head h1.page-head__wide { max-width: 24ch; }
  .page-head__lead { margin-block-start: var(--s-3); max-width: 40rem; }
  .page-head__note {
    margin-block-end: var(--s-3); max-width: 44rem; font-style: italic;
    border-inline-start: 4px solid var(--cyan); padding: 0.75rem 1rem; background: var(--mist); border-radius: 0 var(--radius-s) var(--radius-s) 0;
  }
  [dir='rtl'] .page-head__note { border-radius: var(--radius-s) 0 0 var(--radius-s); }
  @media (max-width: 63.99rem) {
    .page-head__copy, .page-head--media .page-head__copy, .page-head__media { grid-column: 1 / -1; }
    .page-head__media { margin-block-start: var(--s-5); }
  }
</style>
