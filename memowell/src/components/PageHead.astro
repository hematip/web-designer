---
// Inner-page opening (v3): the brand-gradient stage with the label blob on the far side (the catalogue's divider
// pages), breadcrumb pills, oversized H1 and the approved intro copy. Optional media slot on the side.
import { getSite, href, md } from '../lib/content.js';
import Blob from './Blob.astro';

interface Props { locale: string; title: string; body?: string; crumbs?: { label: string; href: string }[]; note?: string; wide?: boolean }
const { locale, title, body, crumbs = [], note, wide = false } = Astro.props;
const ui = getSite(locale).data.ui;
const hasMedia = Astro.slots.has('media');
---
<header class:list={['page-head', 'is-dark', 'aurora', { 'page-head--media': hasMedia }]} data-pointer>
  <div class="wrap page-head__grid">
    <div class="page-head__copy">
      <nav class="breadcrumb" aria-label={ui.breadcrumb}>
        <ol>
          <li><a href={href(locale, '/')}>{ui.home}</a></li>
          {crumbs.map((c) => <li><a href={href(locale, c.href)}>{c.label}</a></li>)}
        </ol>
      </nav>
      {note && <p class="page-head__note">{note}</p>}
      <h1 class:list={{ 'page-head__wide': wide }} data-split="load">{title}</h1>
      {body && <div class="page-head__lead flow" set:html={md(body)} />}
      <slot />
    </div>
    {hasMedia && <div class="page-head__media" data-reveal><slot name="media" /></div>}
  </div>
  <div class="page-head__mark" aria-hidden="true"><Blob id="head-blob" tone="white" /></div>
</header>

<style>
  .page-head {
    margin: 0 clamp(0.5rem, 1.5vw, 1.5rem); border-radius: 0 0 var(--r-xl) var(--r-xl);
    padding-block: calc(var(--header-h) + clamp(3rem, 2rem + 4vw, 6rem)) clamp(3rem, 2rem + 4vw, 6rem);
  }
  .page-head__grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); align-items: center; }
  .page-head__copy { grid-column: 1 / span 9; }
  .page-head--media .page-head__copy { grid-column: 1 / span 7; }
  .page-head__media { grid-column: 8 / span 5; position: relative; }
  .page-head h1 { max-width: 16ch; font-size: clamp(2.5rem, 1.5rem + 4vw, 5.5rem); letter-spacing: -0.028em; line-height: 0.98; }
  .page-head h1.page-head__wide { max-width: 22ch; }
  .page-head__lead { margin-block-start: var(--s-4); max-width: 42rem; font-size: var(--fs-lead); line-height: 1.55; color: var(--on-dark-soft); }
  .page-head__copy :global(.btn-row) { margin-block-start: var(--s-4); }
  .page-head__note {
    margin-block-end: var(--s-4); max-width: 46rem; font-style: italic; color: #fff;
    padding: 0.85rem 1.25rem; border-radius: var(--r-m); background: rgba(6, 178, 200, 0.14); border: 1px solid rgba(6, 178, 200, 0.45);
  }
  /* The label mark, reversed on the gradient, floating off the far edge; the media slot takes its place when present. */
  .page-head__mark { position: absolute; z-index: 0; width: clamp(20rem, 34vw, 32rem); inset-inline-end: -4%; top: 50%; translate: 0 -46%; opacity: 0.16; pointer-events: none; }
  .page-head--media .page-head__mark { display: none; }
  @media (max-width: 63.99rem) {
    .page-head__mark { width: 18rem; top: auto; bottom: -5rem; translate: 0 0; opacity: 0.12; }
    .page-head__copy, .page-head--media .page-head__copy, .page-head__media { grid-column: 1 / -1; }
    .page-head__media { margin-block-start: var(--s-5); }
  }
</style>
