---
// The official front-view bottle on the label's shapes (2026-11-28, client): no pattern, no rings. Two of the
// label's organic shapes stand behind the bottle as faint gradients (low opacity) and drift with the pointer,
// each at its own depth (--ax/--ay from the stage's pointer hook in motion.js; still without a fine pointer, with
// reduced motion or without JS). Decorative only; the bottle is the official cutout, never redrawn.
import Blob from './Blob.astro';
interface Props { alt?: string; id: string }
const { alt = '', id } = Astro.props;
---
<div class="bottle-stage aurora" data-id={id} data-pointer>
  <div class="bottle-stage__mark" aria-hidden="true">
    <div class="bottle-stage__shape bottle-stage__shape--white"><Blob id={`${id}-white`} tone="white" stripes={false} /></div>
    <div class="bottle-stage__shape bottle-stage__shape--cyan"><Blob id={`${id}-cyan`} tone="cyan" stripes={false} /></div>
  </div>
  <img src="/img/bottle-560.webp" srcset="/img/bottle-360.webp 360w, /img/bottle-560.webp 560w, /img/bottle-820.webp 820w" sizes="(min-width: 64rem) 300px, 56vw" width="895" height="1713" alt={alt} />
</div>
<style>
  /* The stage reuses the pointer hook of .aurora but none of its ground: the page head already is the gradient. */
  .bottle-stage { position: relative; isolation: isolate; display: grid; place-items: center; max-width: 30rem; margin-inline: auto; aspect-ratio: 0.9; background: none; overflow: visible; }
  .bottle-stage.aurora::before { content: none; }
  .bottle-stage__mark { position: absolute; z-index: -1; inset: -16%; pointer-events: none; overflow: clip; }
  /* Luminous halos (client 2026-11-28): the label's shapes as soft lights, blurred wide and blended as light. */
  .bottle-stage__shape { position: absolute; left: 50%; top: 50%; opacity: 0.55; filter: blur(44px) saturate(1.1); mix-blend-mode: screen; will-change: translate; transition: translate 1.4s var(--ease-out); }
  .bottle-stage__shape :global(.blob) { filter: drop-shadow(0 0 60px rgba(94, 207, 217, 0.35)); }
  /* Each shape drifts with the pointer at its own depth (--ax/--ay carry a % unit and rest at 72%/38%). */
  .bottle-stage__shape--white { width: 140%; opacity: 0.2; translate: calc(-50% + (var(--ax, 72%) - 72%) * 0.22) calc(-52% + (var(--ay, 38%) - 38%) * 0.22); }
  .bottle-stage__shape--cyan { width: 115%; rotate: -24deg; opacity: 0.42; translate: calc(-62% + (var(--ax, 72%) - 72%) * -0.34) calc(-28% + (var(--ay, 38%) - 38%) * -0.34); }
  :global([dir='rtl']) .bottle-stage__shape--cyan { rotate: 24deg; translate: calc(-38% + (var(--ax, 72%) - 72%) * -0.34) calc(-28% + (var(--ay, 38%) - 38%) * -0.34); }
  .bottle-stage img { position: relative; z-index: 1; width: 58%; filter: drop-shadow(0 30px 34px rgba(20, 30, 80, 0.45)); }
</style>
