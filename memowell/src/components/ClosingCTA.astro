---
// End-of-page invitation or answer (copy supplied per page), in the home page's language: an open block on a
// hairline, no box. tone 'plain': the body is ordinary prose (a question answered), not the large lead line.
import Action from './Action.astro';
import { md } from '../lib/content.js';
interface Props { locale: string; heading?: string; body?: string; actions?: any[]; id?: string; tone?: 'lead' | 'plain' }
const { locale, heading, body, actions = [], id, tone = 'lead' } = Astro.props;
---
<section class="closing-cta" id={id} aria-label={heading ?? undefined}>
  <div class="wrap"><div class="closing-cta__inner" data-reveal>
    {heading && <h2 class="ed-title">{heading}</h2>}
    {body && <div class:list={['prose', { 'ed-pull': tone !== 'plain' }]} set:html={md(body)} />}
    <slot />
    {actions.length > 0 && (
      <div class="btn-row">{actions.map((a, i) => <Action action={a} locale={locale} variant={i === 0 ? 'primary' : 'secondary'} />)}</div>
    )}
  </div></div>
</section>
<style>
  .closing-cta { padding-block: var(--section) 0; }
  .closing-cta__inner { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); row-gap: var(--s-4); align-items: start; padding-block-start: var(--s-5); border-block-start: 1px solid var(--line-strong); }
  .closing-cta h2 { grid-column: 1 / span 5; max-width: 14ch; }
  .closing-cta .prose { grid-column: 7 / span 6; max-width: 40rem; }
  .closing-cta .prose.ed-pull { max-width: 30ch; }
  .closing-cta .btn-row { grid-column: 7 / span 6; }
  @media (max-width: 63.99rem) {
    .closing-cta h2, .closing-cta .prose, .closing-cta .btn-row { grid-column: 1 / -1; }
  }
</style>
