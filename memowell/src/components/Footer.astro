---
import { getSite, href, settings, IS_PREVIEW } from '../lib/content.js';
import { pathIsLive } from '../lib/routes.js';

interface Props { locale: string; routePath: string }
const { locale, routePath } = Astro.props;
const siteStrings = getSite(locale);
const site = siteStrings.data;
const c = settings.contact ?? {};
const contactLinks = [
  c.email && { label: c.email, href: `mailto:${c.email}` },
  c.instagram && { label: 'Instagram', href: c.instagram },
  c.linkedin && { label: 'LinkedIn', href: c.linkedin },
].filter(Boolean);
const isLive = (h: string) => /^(https?:|#|mailto:)/.test(h) || pathIsLive(locale, h);
---
<footer class="site-footer" lang={siteStrings.fallback ? 'en' : undefined}>
  <div class="wrap site-footer__main">
    <div class="site-footer__masthead">
      <a class="site-footer__home" href={href(locale, '/')}>
        <img src="/brand/memowell-logo-colour-transparent.png" width="640" height="142" alt={`Memowell — ${site.ui.home}`} loading="lazy" />
      </a>
      <p class="site-footer__slogan" aria-hidden="true"><span>LIVE WELL,</span>{' '}<span>STAY WELL</span></p>
    </div>

    <div class="site-footer__cols">
      {site.footer_columns.map((col: any) => (
        <div class:list={['site-footer__column', { 'site-footer__column--company': col.products }]}>
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((l: any) => (
              <li>
                {isLive(l.href)
                  ? <a href={href(locale, l.href)} {...(l.external ? { rel: 'noopener' } : {})}>{l.label}</a>
                  : <span>{l.label}{IS_PREVIEW ? ' (unpublished)' : ''}</span>}
              </li>
            ))}
            {col.contact_slots && contactLinks.map((l: any) => <li><a href={l.href}>{l.label}</a></li>)}
            {col.contact_slots && IS_PREVIEW && !contactLinks.length && (
              <li><span class="pending small">[email] · [social links] — not supplied</span></li>
            )}
          </ul>
          {col.products && (
            <p class="site-footer__products">
              {col.products.map((p: string, i: number) => (<>{i > 0 && ', '}<a href={settings.kondor_url} rel="noopener">{p}</a></>))}
            </p>
          )}
        </div>
      ))}
    </div>

  </div>

  <div class="site-footer__base on-dark">
    <div class="wrap">
      <div class="site-footer__trust">
        <a class="site-footer__maker" href={settings.kondor_url} rel="noopener"><img src="/brand/kondor-pharma-logo-white.png" width="640" height="281" alt="Kondor Pharma" loading="lazy" /></a>
        <div class="site-footer__disclaimer" id="disclaimer" tabindex="-1">
          <p>{site.general_disclaimer}</p>
        </div>
      </div>
      <div class="site-footer__last">
        <p>{site.footer_last_line}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ice-2); color: var(--ink); border-block-start: 1px solid var(--line-strong); }
  .site-footer__main { padding-block-start: clamp(3rem, 6vw, 6rem); }
  .site-footer__masthead { display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); padding-block-end: clamp(3rem, 5vw, 5rem); }
  .site-footer__home { display: inline-flex; align-items: center; flex: none; padding-block: var(--s-2); }
  .site-footer__home img { width: clamp(10rem, 15vw, 14rem); height: auto; }
  .site-footer__slogan { font: 700 clamp(2.75rem, 5vw, 5.5rem)/0.98 var(--font-display); letter-spacing: -0.028em; user-select: none; }
  .site-footer__slogan span { display: block; }
  .site-footer__slogan span:last-child { color: var(--royal); }

  .site-footer__cols { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--s-4); padding-block: var(--s-5); border-block-start: 1px solid var(--line-strong); }
  .site-footer__column { min-width: 0; }
  .site-footer h2 { display: flex; align-items: center; gap: var(--s-1); margin-block-end: var(--s-2); font: 700 0.875rem/1.4 var(--font-body); letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-soft); }
  .site-footer h2::before { content: ''; width: 0.4rem; height: 0.4rem; flex: none; border-radius: 50%; background: var(--royal); }
  .site-footer h2:lang(ar) { font-family: var(--font-arabic); letter-spacing: 0; text-transform: none; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
  .site-footer li a, .site-footer li > span { display: inline-flex; align-items: center; min-height: 2.75rem; font-size: var(--fs-small); line-height: 1.5; font-weight: 500; overflow-wrap: anywhere; }
  .site-footer li a { color: var(--ink); text-decoration: none; }
  .site-footer li a:hover { color: var(--royal); text-decoration: underline; }
  .site-footer__products { margin-block-start: var(--s-2); color: var(--ink-soft); font-size: 0.9375rem; line-height: 1.7; }
  .site-footer__products a { display: inline-block; min-height: 1.5rem; color: inherit; }
  .site-footer__column :global(.pending) { margin-block-start: var(--s-1); font-size: 0.9375rem; }


  .site-footer__base { padding-block: var(--s-5) var(--s-4); background: var(--midnight); color: var(--on-dark-soft); }
  .site-footer__trust { display: grid; grid-template-columns: minmax(10rem, 1fr) minmax(0, 3.5fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; padding-block-end: var(--s-5); }
  /* Reversed logo on the midnight base: white wordmark, the official green leaf and PHARMA unchanged; no frame. */
  .site-footer__maker { display: block; width: 9rem; }
  .site-footer__maker img { width: 100%; height: auto; }
  .site-footer__disclaimer { min-width: 0; }
  .site-footer__disclaimer p { max-width: 84ch; font-size: var(--fs-small); line-height: 1.75; }
  .site-footer__last { padding-block-start: var(--s-3); border-block-start: 1px solid var(--glass-line); font-size: 0.9375rem; line-height: 1.7; }

  @media (max-width: 74.99rem) {
    .site-footer__cols { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5) var(--s-4); }
  }
  @media (max-width: 47.99rem) {
    .site-footer__masthead { align-items: flex-start; flex-direction: column; gap: var(--s-4); }
    .site-footer__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer__column--company { grid-column: 1 / -1; }
    .site-footer__column--company ul { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s-4); }
    .site-footer__column--company li:last-child { grid-column: 1 / -1; }
    .site-footer__trust { grid-template-columns: minmax(0, 1fr); gap: var(--s-4); }
  }
  @media (max-width: 23.99rem) {
    .site-footer__cols { grid-template-columns: minmax(0, 1fr); }
  }
</style>
