  .h-who__intro { display: grid; gap: 0.5rem; justify-items: start; }
  .h-who__intro :global(.lead) { font-size: var(--fs-body); line-height: var(--lh-body); }
  .h-who__fact { display: flex; align-items: baseline; gap: 0.6rem; margin-block-start: 0.75rem; font-size: 0.875rem; line-height: 1.5; letter-spacing: 0.01em; color: var(--ink-soft); }
  .h-who__fact::before { content: ''; flex: none; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--cyan); transform: translateY(-0.1em); }
  .h-who__gallery { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 0.5rem; height: clamp(17rem, 32svh, 22rem); margin-block-start: var(--s-2); }
  .h-who__frame { position: relative; min-width: 0; min-height: 0; overflow: hidden; border-radius: var(--r-m); }
  .h-who__frame :global(.photo) { width: 100%; height: 100%; border-radius: inherit; box-shadow: none; }
  .h-who__frame :global(.photo img) { object-position: var(--who-focus); }
  .h-who__list { list-style: none; margin: 0; padding: 0; }
  .h-who__entry { display: grid; align-content: center; gap: var(--s-3); padding-block: var(--s-5); }
  .h-who__detail { display: grid; gap: var(--s-3); }
  .h-who__detail h3 { max-width: 18ch; font-size: clamp(2rem, 1.3rem + 1.8vw, 3rem); line-height: 1.1; letter-spacing: -0.02em; }
  .h-who__detail p { color: var(--ink-soft); font-size: var(--fs-lead); line-height: 1.6; max-width: 35ch; }
  .h-who__mobile-photo { display: none; }
  :global(.h-who.is-story) { --who-stage-h: min(60rem, calc(100svh - var(--header-h) - 2rem)); }
  :global(.h-who.is-story) .h-who__head { position: sticky; top: calc(var(--header-h) + 1rem); height: var(--who-stage-h); grid-template-rows: auto auto minmax(0, 1fr); }
  :global(.h-who.is-story) .h-who__gallery { height: auto; }
  :global(.h-who.is-story) .h-who__entry { display: block; align-content: start; min-height: var(--who-stage-h); padding-block-start: var(--who-entry-inset); }
  :global(.h-who.is-story) .h-who__entry:not(:last-child) { margin-block-end: calc(-1 * var(--who-entry-inset)); }
  :global(.h-who.is-story) .h-who__detail { position: sticky; top: var(--who-detail-top); }
  :global(.h-who.is-story) .h-who__entry:last-child .h-who__detail { position: static; }
  :global(.h-who__gallery.is-focused) { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: minmax(0, 1fr) 4.5rem; }
  :global(.h-who__gallery.is-focused) .h-who__frame { grid-row: 2; border-radius: var(--r-s); }
  :global(.h-who__gallery.is-focused) :global(.h-who__frame.is-active) { grid-column: 1 / -1; grid-row: 1; border-radius: var(--r-m); }

  /* ============ Evidence: the measured gap, on the catalogue's navy ground ============ */
  .h-evidence { position: relative; isolation: isolate; overflow: clip; padding-block: var(--section); }
  .h-evidence__grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); row-gap: clamp(3rem, 6vw, 5rem); align-items: center; }
  .h-evidence__intro { grid-column: 1 / span 5; display: grid; gap: var(--s-4); align-content: center; min-width: 0; }
  .h-evidence__title { max-width: 11ch; color: #fff; font-size: clamp(2.5rem, 1.25rem + 3.4vw, 4.75rem); line-height: 1.02; letter-spacing: -0.028em; }
  .h-evidence__title :global(.accent) { color: var(--cyan); }
  .h-evidence__lead { max-width: 30rem; color: var(--on-dark-soft); font-size: var(--fs-lead); line-height: 1.5; }
  .h-evidence__more { display: grid; gap: var(--s-4); }
  .h-evidence__rule { display: block; height: 1px; background: rgba(255, 255, 255, 0.22); transform-origin: 0 50%; }
  :global([dir='rtl']) .h-evidence__rule { transform-origin: 100% 50%; }
  .h-evidence__more p { max-width: 30rem; color: var(--on-dark-soft); font-size: var(--fs-body); }
  .h-evidence__main { grid-column: 7 / span 6; display: grid; gap: var(--s-3); min-width: 0; }
  .h-evidence__kicker { font: 700 0.875rem/1.2 var(--font-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--cyan); }
  .h-evidence__result { max-width: 34ch; color: #fff; font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.625rem); line-height: 1.45; font-weight: 500; }
  .h-evidence__result :global(mark.figure) { background: none; color: var(--cyan); font-weight: 700; }
  .h-evidence__explain { max-width: 44ch; color: var(--on-dark-soft); font-size: var(--fs-body); }
  .h-evidence__facts { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4) clamp(1rem, 2.5vw, 2.5rem); margin: 0; padding-block-start: var(--s-4); border-block-start: 1px solid rgba(255, 255, 255, 0.22); }
  .h-evidence__facts dt { font: 600 clamp(1.5rem, 1.1rem + 1vw, 2.25rem)/1.1 var(--font-display); letter-spacing: -0.02em; color: #fff; }
  .h-evidence__facts dd { max-width: 24ch; margin: 0.4rem 0 0; color: var(--on-dark-soft); font-size: 1rem; line-height: 1.45; }
  .h-evidence__source { grid-column: 1 / -1; margin-block-start: calc(var(--s-4) * -1); font-size: 0.875rem; overflow-wrap: anywhere; }
  /* The chart. --u is one point of the test; --base lifts the dummy-capsule line off the floor; --gap is the published
     difference; --rise (0…1, motion) raises the Memowell line from the other line to its place. Only the difference is
     drawn: no axis values, no baseline scores. Logical properties, so RTL mirrors it. */
  .h-gap { --u: clamp(2.6rem, 1.6rem + 2.6vw, 3.75rem); --base: 1.1; --lw: 50%; position: relative; height: calc(var(--u) * 6.2); margin-block: var(--s-1) var(--s-2); }
  .h-gap__axis { position: absolute; inset-block: 0; inset-inline-start: 0; width: 0.6rem; border-inline-start: 1px solid rgba(255, 255, 255, 0.28);
    background: repeating-linear-gradient(to top, rgba(255, 255, 255, 0.28) 0 1px, transparent 1px var(--u)); background-position: 0 calc(var(--u) * -0.1); }
  /* The result drawn in the label's pattern: the gap between the two groups' lines is filled with the brand stripes,
     fading in from the axis; it grows with the Memowell line (--rise). */
  .h-gap__fill { position: absolute; inset-inline-start: 1.5rem; width: calc(var(--lw) + 0.75rem); bottom: calc(var(--u) * var(--base)); height: calc(var(--u) * var(--gap) * var(--rise, 1));
    background: repeating-linear-gradient(-38deg, rgba(94, 207, 217, 0.85) 0 4px, transparent 4px 11px);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 45%); mask-image: linear-gradient(90deg, transparent 0%, #000 45%); }
  :global([dir='rtl']) .h-gap__fill { background: repeating-linear-gradient(38deg, rgba(94, 207, 217, 0.85) 0 4px, transparent 4px 11px);
    -webkit-mask-image: linear-gradient(270deg, transparent 0%, #000 45%); mask-image: linear-gradient(270deg, transparent 0%, #000 45%); }
  .h-gap__line { position: absolute; inset-inline-start: 1.5rem; width: var(--lw); height: 3px; border-radius: 3px; }
  .h-gap__line--control { bottom: calc(var(--u) * var(--base)); background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.55) 0 10px, transparent 10px 17px); }
  .h-gap__line--product { bottom: calc(var(--u) * (var(--base) + var(--gap) * var(--rise, 1))); height: 4px; background: #fff; box-shadow: 0 0 22px rgba(94, 207, 217, 0.55); }
  .h-gap__label { position: absolute; inset-inline-start: 0; bottom: 0.8rem; white-space: nowrap; font: 700 0.8125rem/1.2 var(--font-body); letter-spacing: 0.1em; text-transform: uppercase; color: var(--on-dark-mute); }
  .h-gap__line--product .h-gap__label { color: #fff; }
  /* The dummy-capsule label sits inside the striped gap: a navy chip keeps it readable over the stripes. */
  .h-gap__line--control .h-gap__label { z-index: 1; padding: 0.3rem 0.55rem; margin-inline-start: -0.55rem; border-radius: 6px; background: var(--navy); color: var(--on-dark-soft); }
  .h-gap__bracket { position: absolute; inset-inline-start: calc(1.5rem + var(--lw) + 0.75rem); bottom: calc(var(--u) * var(--base)); width: 0.85rem; height: calc(var(--u) * var(--gap));
    border: 2px solid var(--cyan); border-inline-start: 0; border-start-end-radius: 6px; border-end-end-radius: 6px; transform-origin: 50% 100%; transform: scaleY(var(--rise, 1)); }
  .h-gap__figure { position: absolute; inset-inline: calc(1.5rem + var(--lw) + 2.5rem) 0; bottom: calc(var(--u) * var(--base)); height: calc(var(--u) * var(--gap)); display: flex; flex-direction: column; justify-content: center; gap: 0.5rem; opacity: calc(0.2 + 0.8 * var(--rise, 1)); }
  .h-gap__number { font: 600 clamp(3rem, 1rem + 8vw, 8.5rem)/0.86 var(--font-display); letter-spacing: -0.045em; color: #fff; font-variant-numeric: tabular-nums; }
  .h-gap__unit { max-width: 12ch; font: 600 clamp(0.9375rem, 0.85rem + 0.45vw, 1.375rem)/1.2 var(--font-display); color: var(--cyan); }

  /* ============ How to take it: the day, then the course ============ */
  .h-dir { position: relative; overflow-x: clip; padding-block: var(--section); }
  .h-dir__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); row-gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
  .h-dir__top { display: grid; gap: var(--s-2); }
  .h-dir__title { font-size: clamp(2.5rem, 1.25rem + 3vw, 4.25rem); line-height: 1.02; letter-spacing: -0.028em; }
  .h-dir__lead { max-width: 22ch; color: var(--ink); font: 600 clamp(1.25rem, 1.05rem + 0.7vw, 1.75rem)/1.3 var(--font-display); letter-spacing: -0.015em; }
  /* Desktop: the product stage takes the start half of the section, across the heading and the day; the heading and
     the day row stand in the end half. --cell / --tick size the time row and the ticks. */
  .h-dir__stage { grid-column: 1 / span 6; grid-row: 1 / span 2; position: relative; display: grid; place-items: center; align-self: stretch;
    min-height: clamp(30rem, 70svh, 44rem); }
  /* Two of the label's shapes, overlapping in the brand's two blues: the large navy one behind, the cyan one over it,
     smaller, turned and set toward the bottle's base (the catalogue's product pages). */
  .h-dir__mark { position: absolute; width: min(118%, 46rem); left: 50%; top: 50%; translate: -50% -48%; }
  .h-dir__mark--cyan { width: min(98%, 38rem); translate: -50% -30%; rotate: -24deg; }
  :global([dir='rtl']) .h-dir__mark--cyan { translate: -50% -30%; rotate: 24deg; }
  .h-dir__bottle { position: relative; z-index: 1; width: min(46%, 18rem); height: auto; max-width: none; translate: 0 4%;
    filter: drop-shadow(0 34px 30px rgba(20, 30, 80, 0.38)); }
  .h-dir__top { grid-column: 7 / span 6; grid-row: 1; align-self: end; }
  .h-dir__daybox { --cell: clamp(2.25rem, 1.6rem + 2vw, 3.25rem); --tick: 0.8rem; grid-column: 7 / span 6; grid-row: 2; align-self: start;
    display: grid; gap: clamp(1.25rem, 2.5vw, 2.25rem); min-width: 0; }
  .h-dir__day { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.75rem, 3vw, 2.5rem); margin: 0; padding: var(--s-2) 0 0; list-style: none; }
  .h-dir__line { position: absolute; z-index: 0; inset-inline: 10%; top: calc(var(--s-2) + var(--cell) + var(--s-2) + var(--tick) / 2); height: 2px; border-radius: 2px; background: var(--line-strong); overflow: hidden; }
  .h-dir__line span { display: block; width: 100%; height: 100%; background: linear-gradient(90deg, var(--blue), var(--cyan)); transform-origin: 0 50%; transform: scaleX(var(--draw, 1)); }
  :global([dir='rtl']) .h-dir__line span { transform-origin: 100% 50%; background: linear-gradient(270deg, var(--blue), var(--cyan)); }
  .h-dose { position: relative; z-index: 1; display: grid; justify-items: center; align-content: start; gap: var(--s-2); min-width: 0; }
  .h-dose__time { display: flex; align-items: end; height: var(--cell); font: 600 clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem)/1 var(--font-display); letter-spacing: -0.02em; color: var(--ink); }
  .h-dose__tick { width: var(--tick); aspect-ratio: 1; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 5px var(--paper); }
  .h-dose__note { max-width: 14ch; text-align: center; color: var(--ink-soft); font-size: clamp(0.9375rem, 0.9rem + 0.2vw, 1.0625rem); text-wrap: balance; }
  .h-dir__food { max-width: 36rem; justify-self: center; text-align: center; color: var(--ink-soft); font-size: var(--fs-body); }
  .h-course__copy { margin-block-start: clamp(2rem, 4vw, 3.5rem); grid-column: 1 / span 5; display: grid; gap: var(--s-3); justify-items: start; min-width: 0; }
  .h-course__title { font-size: clamp(2rem, 1.2rem + 2.2vw, 3.25rem); line-height: 1.05; letter-spacing: -0.025em; }
  .h-course__text { max-width: 36ch; color: var(--ink-soft); font-size: var(--fs-body); }
  .h-course__text:first-of-type { color: var(--ink); font-size: var(--fs-lead); line-height: 1.5; }
  /* The course: 8 weeks × 7 days, each day a row of the day's doses. --n (motion) is how many doses are filled; each
     pip's --i is its place in the course, so one property paints the whole calendar. Without motion it is full. */
  .h-course { margin-block-start: clamp(2rem, 4vw, 3.5rem); --pip: clamp(0.4rem, 0.2rem + 0.75vw, 0.8rem); grid-column: 6 / span 7; min-width: 0; }
  .h-course__weeks { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 0 clamp(0.25rem, 1vw, 0.75rem); margin: 0; padding: 0; list-style: none; }
  .h-course__week { display: grid; justify-items: center; gap: var(--s-2); }
  .h-course__days { display: grid; gap: calc(var(--pip) * 1.15); }
  .h-course__day { display: flex; gap: calc(var(--pip) * 0.35); }
  .h-course__day i { position: relative; display: block; width: var(--pip); aspect-ratio: 1; border-radius: 50%; background: var(--line); }
  .h-course__day i::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: var(--c); transform: scale(clamp(0, calc(var(--n, 999) - var(--i)), 1)); }
  .h-course__week small { font: 600 0.875rem/1 var(--font-body); color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .h-course__week:last-child small { color: var(--navy-deep); font-weight: 800; }

  /* ============ Professional route ============ */
  .h-pro { padding-block: 0 calc(var(--section) * 0.35); }
  .h-pro__stage { position: relative; display: grid; align-items: center; }
  .h-pro__photo, .h-pro__stage > :global(.h-pro__glass) { grid-area: 1 / 1; }
  .h-pro__photo { position: relative; height: 100%; min-height: clamp(30rem, 52vw, 46rem); max-height: 88svh; overflow: hidden; border-radius: var(--r-xl); }
  .h-pro__photo :global(.photo) { border-radius: inherit; transform-origin: 70% 45%; }
  :global([dir='rtl']) .h-pro__photo :global(.photo img) { scale: -1 1; }
  .h-pro__stage > :global(.h-pro__glass) { justify-self: start; display: grid; gap: var(--s-3); width: min(48%, 40rem); margin-inline-start: 3.5%; padding: clamp(3rem, 5.5vw, 5.25rem) clamp(2.75rem, 5.5vw, 5.5rem) clamp(3.25rem, 6vw, 5.75rem); font-size: var(--fs-body); }
  .h-pro:not(.h-pro--photo) .h-pro__stage > :global(.h-pro__glass) { width: 100%; max-width: 52rem; margin: 0; --glass-a1: 1; --glass-a2: 0.8; }
  /* A soft cool shade on the bright window side gives the clear glass something to read against. */
  .h-pro__photo::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(10, 18, 64, 0.34) 0%, rgba(10, 18, 64, 0.16) 32%, rgba(10, 18, 64, 0) 58%); }
  :global([dir='rtl']) .h-pro__photo::after { background: linear-gradient(270deg, rgba(10, 18, 64, 0.34) 0%, rgba(10, 18, 64, 0.16) 32%, rgba(10, 18, 64, 0) 58%); }
  .h-pro__stage :global(.h-pro__glass h2) { max-width: 18ch; font-size: clamp(1.75rem, 1.2rem + 1.5vw, 2.75rem); line-height: 1.12; letter-spacing: -0.02em; }
  .h-pro__stage :global(.h-pro__glass p) { max-width: 34ch; }

  /* ============ Where to find it: copy beside an arched photograph ============ */
  /* overflow-x: the photo's entrance starts at scale 1.18 inside its clip-path frame; clip-path hides it but does not
     stop it widening the page, which made 320px screens scroll sideways. */
  /* Where: the photograph (end side) under the wave; the wave layer reaches --reach above the section, over the end of
     "How to take it". Layers: photograph, stripe blob, wave (rim + blue), copy. */
  /* Taller on wide screens (the height follows the width up to 70rem), and its foot is cut by the same arch as the
     closing dome below (--arch-rx / --arch-ry: the dome's ellipse; --arch-sag: how far the arch rises at the centre;
     set from the dome by home-scenes.js, with these fallbacks), so the white band with the bottle runs between two
     parallel curves. */
  .h-where { --reach: clamp(9rem, 24vh, 15rem); --arch-rx: 92%; --arch-ry: 44rem; --arch-sag: 7rem; position: relative; z-index: 1; display: flex; align-items: center;
    min-height: clamp(44rem, max(100svh, 50vw), 70rem); padding-block: var(--section) calc(var(--section) + var(--arch-sag)); overflow-x: clip; color: #fff; }
  .h-where::after { content: ''; position: absolute; z-index: 3; left: 0; right: 0; bottom: -1px; height: calc(var(--arch-sag) + 1px); pointer-events: none;
    background: radial-gradient(var(--arch-rx) var(--arch-ry) at 50% var(--arch-ry), var(--paper) calc(100% - 1.5px), transparent 100%); }
  /* The photograph keeps both people clear of the wave's edge: its box starts where the edge stands at head height
     (--photo-start, set by home-scenes.js; 30% without it) and fades in from the pharmacy's own light; the top is a
     soft wave, not a straight cut. */
  .h-where__photo { position: absolute; z-index: 0; inset-block: 0; inset-inline: var(--photo-start, 30%) 0; overflow: hidden; background: #e8eef3;
    -webkit-clip-path: url(#where-photo-edge); clip-path: url(#where-photo-edge); }
  .h-where__photo :global(.photo) { position: absolute; inset-block: 0; inset-inline-end: 0; width: 100%; height: 100%; border-radius: 0; box-shadow: none;
    -webkit-mask-image: linear-gradient(to left, #000 97%, transparent); mask-image: linear-gradient(to left, #000 97%, transparent); }
  :global([dir='rtl']) .h-where__photo :global(.photo) { -webkit-mask-image: linear-gradient(to right, #000 97%, transparent); mask-image: linear-gradient(to right, #000 97%, transparent); }
  .h-where__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .h-where__stripes { position: absolute; z-index: 1; top: 0; left: 0; width: clamp(12rem, 22vw, 20rem); height: auto; pointer-events: none; transform: translate(var(--sx, 52vw), var(--sy, -2rem)); }
  .h-where__shape { position: absolute; z-index: 1; left: 0; top: calc(var(--reach) * -1); width: 100%; height: calc(100% + var(--reach)); pointer-events: none; overflow: hidden; }
  .h-where__grid { position: relative; z-index: 2; width: 100%; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); align-items: center; }
  .h-where__copy { grid-column: 1 / span 5; display: grid; gap: var(--s-4); justify-items: start; min-width: 0; max-width: 27rem; }
  .h-where__title { max-width: 11ch; color: #fff; font-size: clamp(2.5rem, 1.25rem + 3.4vw, 4.75rem); line-height: 1.02; letter-spacing: -0.028em; }
  .h-where__text { color: var(--on-dark-soft); font-size: var(--fs-lead); line-height: 1.5; }
  .h-where :focus-visible { outline-color: var(--focus-on-dark); }
  /* RTL: the wave is drawn mirrored by the script; the photograph moves to the other side unflipped. */

  /* ============ Closing: typographic invitation; the bottle on a soft light inside opening rings ============ */
  /* ============ Closing: the label rises (pinned finale; this CSS is the resolved frame) ============ */
  .h-close { position: relative; isolation: isolate; overflow: clip; min-height: 100svh; display: grid; align-items: center; background: var(--paper); }
  /* The blue: the whole stage at rest; the scene clips it to the rising dome, then floods it (home-scenes.js). */
  .h-close__stage { position: absolute; inset: 0; z-index: 0; background: var(--brand-gradient-diag); }
  .h-close__inner { position: relative; z-index: 2; width: 100%; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); align-items: center;
    padding-block: calc(var(--header-h) + 1.5rem) clamp(2.5rem, 5vw, 4rem); }
  /* The product: the bottle over the label's shapes, a soft cyan light under it and its reflection on the blue — the
     original long reflection (fading over 55% of the bottle's height, 36% on phones). Its opacity is 0.22 × --show (the
     scene brings it in) × --leave (it fades out as the footer comes up, so no cut-off tail shows at the section's foot
     when the footer is in view). */
  .h-close__reflection { --fade: 55%; position: absolute; z-index: 1; top: 100%; left: 0; width: 100%; height: auto; max-width: none; pointer-events: none; transform: scaleY(-1) translateY(2px);
    opacity: calc(0.22 * var(--show, 1) * var(--leave, 1));
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent var(--fade)); mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent var(--fade)); }
  .h-close__product { grid-column: 1 / span 6; position: relative; isolation: isolate; justify-self: center; width: min(30vw, 19rem, 30svh); }
  .h-close__bottle { position: relative; z-index: 1; display: block; width: 100%; height: auto; max-width: none; filter: drop-shadow(0 30px 32px rgba(10, 18, 60, 0.45)); }
  .h-close__glow { position: absolute; z-index: 0; left: 50%; bottom: -16%; width: 190%; aspect-ratio: 2.2; translate: -50% 0; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgba(94, 207, 217, 0.42), rgba(94, 207, 217, 0) 100%); }
