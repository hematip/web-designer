---
import Base from '../layouts/Base.astro';
import Action from '../components/Action.astro';
import Sources from '../components/Sources.astro';
import Photo from '../components/Photo.astro';
import Blob from '../components/Blob.astro';
import { getPage, getSite, section, md, mdInline, photoOf } from '../lib/content.js';

const { locale, routePath } = Astro.props;
const { data: page, fallback } = getPage(locale, 'home');
const s = (id: string) => section(page, id);
const hero = s('hero'), why = s('why'), formulation = s('formulation'), who = s('who'),
  evidence = s('evidence'), directions = s('directions'), pro = s('professionals'),
  availability = s('availability'), closing = s('closing');

// Typographic emphasis only — the words never change.
const accentWord = (text: string, word?: string) =>
  word && text.includes(word) ? text.replace(word, `<span class="accent">${word}</span>`) : text;
const highlight = (html: string, phrase?: string) =>
  phrase ? html.replace(phrase, `<mark class="figure">${phrase}</mark>`) : html;
// Hero answer: the first sentence is the statement, the rest supports it. "someone you love" carries the emphasis.
const heroAnswer = hero.lead ? (() => {
  const m = String(hero.lead).match(/^(.+?[.?!])\s+([\s\S]+)$/);
  const statement = m ? m[1] : String(hero.lead);
  return { statement: statement.replace('someone you love', '<span class="h-hero__love">someone you love</span>'), rest: m ? m[2] : '' };
})() : null;
const evidenceParas = (evidence.body ?? '').split(/\n\s*\n/);
const directionsParas = (directions.body ?? '').split(/\n\s*\n/).filter(Boolean);
const directionsMeals: { title: string; body: string }[] = directions.items ?? [];
const whyParas = (why.body ?? '').split(/\n\s*\n/).filter(Boolean);
// The three moments families notice first get a quiet typographic emphasis (words unchanged).
const whyMoments = (html: string) => ['forgetting names', 'losing the thread of a conversation', 'repeating a question']
  .reduce((h, m) => h.replace(m, `<span class="h-why__moment">${m}</span>`), html);
// Recompose the approved heading without changing its wording; other translations keep their full heading.
const whyTitle = why.heading.match(/^(One thing researchers are looking at:) (inflammation in the nervous system)$/);
const ui = getSite(locale).data.ui;
// Hero film (Kondor Brain, VIDEO-SCENARIO-v3 "the wall of names"): silent, plays once and holds its last frame.
const film = { src: '/video/hero-names', poster: '/video/hero-names-poster.webp' };
const whyPhoto = photoOf(locale, 'home', 'why');
const proPhoto = photoOf(locale, 'home', 'professionals');
const wherePhoto = photoOf(locale, 'home', 'availability');
// Existing illustrative scenes: care, family, everyday planning and active mid-life.
const whoPhotos = [
  photoOf(locale, 'who-its-for', 'intro'),
  photoOf(locale, 'memory-health', 'intro'),
  // "Brain fog and delirium": everyday planning. Its own picture, not the Why section's research photograph.
  { src: '/img/photos/caregiver-planner', width: 1600, height: 2000, widths: [640, 1024, 1600], alt: '' },
  photoOf(locale, 'memowell', 'directions'),
];
const whoPhotoFocus = ['55% 24%', '50% 26%', '50% 12%', '40% 0%'];
// Formulation story: one chapter per stage of the 3D scene (resin → capsule).
const chapters: { label: string; body?: string }[] = formulation.chapters ?? [];
---
<Base locale={locale} routePath={routePath} title={page.meta_title} description={page.meta_description} fallback={fallback} status={page.status} bodyClass="page-home">

  <!-- 1 · The approved question and family film; the formulation story follows "why". -->
  <section class="h-hero is-dark" aria-labelledby="hero-title" data-hero data-text-motion="off">
    <!-- The label mark at hero scale: the film sits inside the deep-blue blob, the cyan stripe blob tucks behind it
         and two drops float beside it (the catalogue's photo-in-a-blob). On scroll the hero pins and the blob opens into
         a landscape frame of the film while the copy and the mark's satellites step back (home-scenes.js). -->
    <div class="h-hero__mark" aria-hidden="true" data-hero-mark>
      <svg class="h-hero__stripes" viewBox="0 0 440 330" preserveAspectRatio="xMidYMid meet">
        <defs><pattern id="hero-stripes" width="11" height="11" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)"><rect width="4.2" height="11" fill="var(--cyan-stripe)" /></pattern></defs>
        <path fill="url(#hero-stripes)" d="M232 40C300 24 384 56 398 124C412 192 364 264 300 286C236 308 160 284 128 228C96 172 164 56 232 40Z" data-blob-stripe data-alt="M214 48C290 18 392 70 404 136C416 202 352 276 284 292C216 308 148 272 124 216C100 160 138 78 214 48Z" />
      </svg>
      <div class="h-hero__film">
        <svg class="h-hero__film-clip" width="0" height="0" aria-hidden="true" focusable="false">
          <clipPath id="hero-blob" clipPathUnits="objectBoundingBox">
            <!-- Ten cubics (the blob split in halves) so the opening scene can morph it into a rounded landscape frame. -->
            <path d="M0.345 0.194C0.411 0.131 0.505 0.092 0.599 0.087C0.692 0.082 0.784 0.109 0.845 0.176C0.906 0.242 0.929 0.337 0.925 0.434C0.921 0.532 0.891 0.633 0.845 0.715C0.8 0.797 0.735 0.859 0.661 0.893C0.586 0.926 0.502 0.93 0.418 0.897C0.334 0.863 0.263 0.813 0.212 0.752C0.161 0.691 0.13 0.618 0.123 0.539C0.116 0.461 0.139 0.406 0.18 0.355C0.22 0.304 0.279 0.258 0.345 0.194Z" data-hero-clip />
          </clipPath>
        </svg>
        <!-- Sources are chosen in home-scenes.js (720p on phones); the 1080p pair is the no-JS fallback. -->
        <video data-hero-film data-src={film.src} muted playsinline preload="metadata" poster={film.poster} width="1920" height="1080">
          <source src={`${film.src}-1080.webm`} type="video/webm" />
          <source src={`${film.src}-1080.mp4`} type="video/mp4" />
        </video>
      </div>
      <span class="h-hero__drop h-hero__drop--a" data-blob-drop></span>
      <span class="h-hero__drop h-hero__drop--b" data-blob-drop></span>
    </div>
    <div class="wrap h-hero__grid">
      <div class="h-hero__intro">
        <h1 id="hero-title" class="h-hero__title" data-hero-title set:html={accentWord(hero.heading, hero.accent)} />
        {heroAnswer && (
          <p class="h-hero__answer" data-hero-answer>
            <span class="h-hero__statement" data-hero-statement set:html={heroAnswer.statement} />{' '}
            {heroAnswer.rest && <span class="h-hero__support" data-hero-in>{heroAnswer.rest}</span>}
          </p>
        )}
        <div class:list={['h-hero__meta', { 'has-bottle': hero.product_image_alt }]}>
          {hero.product_image_alt && (
            <img class="h-hero__bottle" data-hero-in src="/img/bottle-360.webp"
              srcset="/img/bottle-360.webp 360w, /img/bottle-560.webp 560w" sizes="(min-width: 56.25rem) 8rem, 6rem"
              width="360" height="689" alt={hero.product_image_alt} fetchpriority="high" />
          )}
          <div class="h-hero__lead" data-hero-in set:html={md(hero.body)} />
          <div class="btn-row" data-hero-in>
            {hero.actions.map((a: any, i: number) => <Action action={a} locale={locale} variant={i === 0 ? 'light' : 'secondary'} />)}
          </div>
          {hero.trust && <p class="h-hero__trust" data-hero-in>{hero.trust}</p>}
        </div>
      </div>
    </div>
    <button class="h-hero__toggle" type="button" data-hero-film-toggle data-label-pause={ui.pause_video} data-label-play={ui.play_video} hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /><path class="i-play" d="M8 5.5v13l11-6.5z" /></svg>
      <span class="visually-hidden" data-label>{ui.pause_video}</span>
    </button>
    <div class="h-cue" aria-hidden="true"><span></span></div>
  </section>

  <!-- 2 · Why memory changes -->
  <section class="h-why" id="why" aria-labelledby="why-title">
    <div class:list={['wrap', 'h-why__grid', { 'h-why__grid--text': !whyPhoto }]}>
      <div class="h-why__heading">
        <h2 id="why-title" class="h-why__title" data-split>
          {whyTitle ? <><span class="h-why__context">{whyTitle[1]}</span>{' '}<span class="h-why__subject" set:html={accentWord(whyTitle[2], 'inflammation')} /></> : why.heading}
        </h2>
      </div>
      {whyPhoto && <div class="h-why__photo" data-reveal><Photo photo={whyPhoto} variant="portrait" sizes="(min-width: 64rem) 40vw, (min-width: 40rem) 70vw, 92vw" /></div>}
      <div class="h-why__body">
        {whyParas.map((p: string, i: number) => (
          i === 0
            ? <div class="h-why__paragraph" data-reveal set:html={whyMoments(md(p))} />
            : <div class="h-why__note" role="note" data-reveal data-text-emphasis set:html={md(p)} />
        ))}
      </div>
      {(why.inline_action || why.sources?.length) && (
        <div class="h-why__footer" data-reveal>
          {why.inline_action && <p><Action action={why.inline_action} locale={locale} variant="link" /></p>}
          <Sources dois={why.sources} locale={locale} />
        </div>
      )}
    </div>
  </section>

  <!-- 3 · K-Vie™ → AKBA → capsule (real-time 3D), text in step with the scene -->
  <section class="h-form is-dark" id="formulation" aria-labelledby="formulation-title" data-form>
    <div class="h-form__pin aurora" data-pointer data-form-pin>
      <div class="wrap h-form__grid">
        <div class="h-form__scene" data-form-scene>
          <canvas class="h-form__canvas" data-form-canvas aria-hidden="true"></canvas>
          <div class="h-form__frame" data-form-frame aria-hidden="true">
            <!-- Poster / fallback: the resolved frame of the scene (closed capsule), shown until WebGL is ready. -->
            <svg class="h-form__poster" viewBox="0 0 600 600">
              <defs>
                <radialGradient id="halo-g" cx="50%" cy="50%" r="50%">
                  <stop offset="0" stop-color="#8fe4ee" stop-opacity=".3" /><stop offset="1" stop-color="#124a95" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="cap-l" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fbf0dd" /><stop offset=".55" stop-color="#f0dcbc" /><stop offset="1" stop-color="#d9b88c" /></linearGradient>
                <linearGradient id="cap-r" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f6e4c6" /><stop offset=".55" stop-color="#e8cba2" /><stop offset="1" stop-color="#cda679" /></linearGradient>
              </defs>
              <circle cx="300" cy="300" r="260" fill="url(#halo-g)" />
              <g transform="rotate(-22 300 300)">
                <path d="M195 225h105v150H195a75 75 0 0 1 0-150z" fill="url(#cap-l)" />
                <path d="M300 225h105a75 75 0 0 1 0 150H300z" fill="url(#cap-r)" />
                <path d="M300 225v150" stroke="#c49a69" stroke-width="3" opacity=".6" />
                <path d="M170 262c26-22 90-26 160-22" stroke="#fff" stroke-width="12" stroke-linecap="round" opacity=".5" fill="none" />
              </g>
            </svg>
          </div>

          <div class="h-story">
            <h2 id="formulation-title" class="h-story__title">{formulation.heading}</h2>
            <div class="h-story__rail" data-form-rail aria-hidden="true">{chapters.map(() => <span />)}</div>
            <ol class="h-story__chapters" role="list" data-text-motion="off">
              {chapters.map((c, i) => (
                <li class="h-chapter" data-chapter={i + 1}>
                  <p class="h-chapter__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}<span> / {String(chapters.length).padStart(2, '0')}</span></p>
                  <h3 class="h-chapter__label">{c.label}</h3>
                  {c.body && <div class="h-chapter__body" set:html={md(c.body)} />}
                  {i === chapters.length - 1 && (
                    <div class="btn-row">{formulation.actions.map((a: any) => <Action action={a} locale={locale} variant="light" />)}</div>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Four research contexts come into focus; the complete copy stays in reading flow. -->
  <section class="h-who" id="who" aria-labelledby="who-title" data-who-story>
    <div class="wrap h-who__layout">
      <div class="h-who__head">
        <h2 id="who-title" set:html={accentWord(who.heading, 'for')} />
        <div class="h-who__intro" data-reveal>
          <p class="lead" set:html={mdInline(who.body)} />
          <Action action={who.inline_action} locale={locale} variant="link" />
          {who.fact && <p class="h-who__fact">{who.fact}</p>}
        </div>
        <div class="h-who__gallery" data-who-gallery aria-hidden="true">
          {whoPhotos.map((photo, i) => photo && (
            <div class="h-who__frame" data-who-frame style={`--who-focus: ${whoPhotoFocus[i]}`}>
              <Photo photo={photo} variant="fill" sizes="(min-width: 64rem) 45vw, 1px" />
            </div>
          ))}
        </div>
      </div>
      <ol class="h-who__list" role="list" data-text-motion="off">
        {who.items.map((item: any, i: number) => (
          <li class="h-who__entry" id={`who-group-${i + 1}`} data-who-entry>
            <div class="h-who__detail">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
            {whoPhotos[i] && <div class="h-who__mobile-photo" aria-hidden="true" style={`--study-ratio: ${whoPhotos[i].width} / ${whoPhotos[i].height}`}><Photo photo={whoPhotos[i]} variant="portrait" sizes="(max-width: 63.99rem) 92vw, 1px" /></div>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5 · Evidence: the main result sits inside the label blob (deep blue, stripe blob behind) on a pale stage, with its
       population, duration, comparison and source in the same shape. -->
  <section class="h-evidence" id="evidence" aria-labelledby="evidence-title">
    <div class="wrap h-evidence__grid">
      <div class="h-evidence__intro" data-intro data-text-motion="off">
        <h2 id="evidence-title" class="h-evidence__title" set:html={accentWord(evidence.heading, 'research')} />
        {evidence.lead && <p class="h-evidence__lead" data-intro-lines>{evidence.lead}</p>}
        <div class="h-evidence__more">
          <span class="h-evidence__rule" aria-hidden="true" data-intro-rule></span>
          {evidenceParas[2] && <p data-intro-part>{evidenceParas[2]}</p>}
          <div class="btn-row" data-intro-part>
            {evidence.actions.map((a: any, i: number) => <Action action={a} locale={locale} variant={i === 0 ? 'primary' : 'secondary'} />)}
          </div>
        </div>
      </div>
      <div class="h-evidence__panel blob-panel blob-panel--brand" data-blob-card style="--blob-clip: url(#ev-clip)">
        <svg class="blob-panel__defs" width="0" height="0" aria-hidden="true" focusable="false">
          <clipPath id="ev-clip" clipPathUnits="userSpaceOnUse"><path d="M0 0" data-blob-main data-blob-fit /></clipPath>
        </svg>
        <span class="blob-panel__stripes" aria-hidden="true"></span>
        <div class="h-evidence__inner blob-panel__inner">
        {evidence.eyebrow && <p class="h-evidence__kicker" data-glass-part>{evidence.eyebrow}</p>}
        {evidence.highlight && (
          <p class="h-evidence__figure" aria-hidden="true" data-glass-part>
            <span class="h-evidence__number" data-figure>{evidence.highlight}</span>
            <span class="h-evidence__unit">{evidence.unit ?? 'points higher on the MMSE'}</span>
          </p>
        )}
        <p class="h-evidence__result" data-glass-part set:html={highlight(mdInline(evidenceParas[0] ?? ''), evidence.highlight)} />
        {evidenceParas[1] && <p class="h-evidence__explain" data-glass-part>{evidenceParas[1]}</p>}
        {evidence.items?.length > 0 && (
          <dl class="h-evidence__facts" data-glass-part>
            {evidence.items.map((f: any) => <div><dt>{f.title}</dt><dd>{f.body}</dd></div>)}
          </dl>
        )}
        {evidence.sources?.length > 0 && <div class="h-evidence__source" data-glass-part><Sources dois={evidence.sources} locale={locale} /></div>}
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · How to take it: a day in three doses, typographic. Left, the dose line, then one line across the day with
       the three times of day standing on it; the line draws with scroll and each time rises as it is reached. No
       capsule or plate imagery (client direction). Right, the eight-week panel, whose weeks fill as it scrolls up. -->
  <section class="h-dir" id="directions" aria-labelledby="directions-title" data-dir>
    <div class="wrap h-dir__scene" data-dir-scene>
      <div class="h-dir__main">
        <div class="h-dir__top">
          <h2 id="directions-title" class="h-dir__title">{directions.heading}</h2>
          {directions.lead && <p class="h-dir__lead" data-text-lines>{directions.lead}</p>}
        </div>
        <ol class="h-dir__day" role="list" data-dir-day>
          <span class="h-dir__line" aria-hidden="true"><span data-dir-line></span></span>
          {directionsMeals.map((m: any, i: number) => (
            <li class="h-dose" data-dir-dose>
              <p class="h-dose__time">{m.title}</p>
              <span class="h-dose__tick" aria-hidden="true"></span>
              <p class="h-dose__note">{m.body}</p>
            </li>
          ))}
        </ol>
        {directionsParas[0] && <p class="h-dir__food">{directionsParas[0]}</p>}
      </div>
      <div class="h-dir__side">
        <div class="h-dir__panel blob-panel blob-panel--sky" data-blob-card style="--blob-clip: url(#wk-clip)">
          <svg class="blob-panel__defs" width="0" height="0" aria-hidden="true" focusable="false">
            <clipPath id="wk-clip" clipPathUnits="userSpaceOnUse"><path d="M0 0" data-blob-main data-blob-fit /></clipPath>
          </svg>
          <span class="blob-panel__stripes" aria-hidden="true"></span>
          <div class="h-dir__panel-inner blob-panel__inner">
          {directions.eyebrow && <h3 class="h-dir__panel-title" data-glass-part>{directions.eyebrow}</h3>}
          <div class="h-weeks" aria-hidden="true" data-glass-part data-weeks>
            <ol class="h-weeks__track" role="list">{Array.from({ length: 8 }, (_, i) => <li><span data-week></span><small>{i + 1}</small></li>)}</ol>
          </div>
          {directionsParas.slice(1).map((p: string) => <p class="h-dir__panel-text" data-glass-part>{p}</p>)}
          <div class="h-dir__panel-action" data-glass-part>{directions.actions.map((a: any) => <Action action={a} locale={locale} variant="link" />)}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7 · Professional band: retired from the plain-language home (2026-11-08); renders only if the CMS section returns.
       Professionals reach their section from the Science menu and the band at the end of the other content pages. -->
  {pro.lead && (
  <aside class:list={['h-pro', { 'h-pro--photo': proPhoto }]} id="professionals" aria-labelledby="professionals-title" data-pro>
    <div class="wrap">
      <div class="h-pro__stage">
        {proPhoto && <div class="h-pro__photo" data-pro-photo><Photo photo={proPhoto} variant="fill" sizes="(min-width: 90rem) 1360px, 94vw" /></div>}
        <div class="h-pro__glass">
          <h2 id="professionals-title">{pro.lead}</h2>
          <p>{pro.body}</p>
          <div class="btn-row">{pro.actions.map((a: any) => <Action action={a} locale={locale} variant="link" />)}</div>
        </div>
      </div>
    </div>
  </aside>
  )}

  <!-- 8 · Where to find it: plain copy with a staged entrance; the pharmacy photograph in an arched frame, revealed
       from the bottom like a curtain while the image settles. -->
  <section class="h-where" id="where" aria-labelledby="where-title">
    <div class="wrap h-where__grid">
      <div class="h-where__copy" data-intro data-text-motion="off">
        <h2 id="where-title" class="h-where__title">{availability.heading}</h2>
        {availability.body && <p class="h-where__text" data-intro-lines>{availability.body}</p>}
        <div class="btn-row" data-intro-part>{availability.actions.map((a: any) => <Action action={a} locale={locale} />)}</div>
      </div>
      {wherePhoto && <div class="h-where__photo" style={`--photo-ratio: ${wherePhoto.width} / ${wherePhoto.height}`} data-where-photo><Photo photo={wherePhoto} variant="portrait" sizes="(min-width: 64rem) 40vw, 92vw" /></div>}
    </div>
  </section>

  <!-- 9 · Closing: a large typographic invitation on the brand gradient; the bottle stands in front of the label
       mark (white blob, cyan stripes) that opens behind it. -->
  <section class="h-close" id="closing" aria-labelledby="closing-title">
    <div class="wrap">
      <div class="h-close__stage is-dark" data-close>
        <div class="h-close__copy" data-intro data-text-motion="off">
          <h2 id="closing-title" class="h-close__title" set:html={accentWord(closing.heading, closing.accent ?? 'conversation')} />
          <p class="h-close__text" data-intro-lines>{closing.body}</p>
          <div class="btn-row" data-intro-part>{closing.actions.map((a: any) => <Action action={a} locale={locale} variant="light" />)}</div>
        </div>
        <div class="h-close__visual" aria-hidden="true">
          <div class="h-close__mark" data-close-mark><Blob id="close-blob" tone="white" /></div>
          <img class="h-close__bottle" data-close-bottle src="/img/bottle-560.webp" srcset="/img/bottle-360.webp 360w, /img/bottle-560.webp 560w, /img/bottle-820.webp 820w" sizes="(min-width: 64rem) 15rem, 40vw" width="895" height="1713" alt="" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/home-scenes.js';
</script>

<style>
  /* ============ Hero ============ */
  /* Blob panel: the label blob as a text container. The outline is drawn in pixels from the panel's own size and
     padding (home-scenes.js, `fitBlobPanels`) so its curves never reach the copy, then morphed by the motion layer.
     Until it is fitted (and without JS) an uneven border-radius stands in. The stripe blob peeks over the top edge. RTL mirrors. */
  .blob-panel { position: relative; isolation: isolate; border-radius: 46% 54% 50% 50% / 8rem 7rem 9rem 8rem; }
  .blob-panel.is-fit { border-radius: 0; -webkit-clip-path: var(--blob-clip); clip-path: var(--blob-clip); }
  .blob-panel--brand { background: var(--brand-gradient-diag); }
  .blob-panel--sky { background: var(--sky); }
  .blob-panel__defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .blob-panel__stripes { position: absolute; z-index: 0; width: 46%; aspect-ratio: 1.3; inset-inline-end: -6%; top: -4%; pointer-events: none; opacity: 0.85;
    background: repeating-linear-gradient(-38deg, var(--cyan-stripe) 0 4px, transparent 4px 11px);
    -webkit-mask-image: radial-gradient(closest-side, #000 60%, transparent 100%); mask-image: radial-gradient(closest-side, #000 60%, transparent 100%); }
  .blob-panel__inner { position: relative; z-index: 1; padding: clamp(4rem, 7vw, 6.5rem) clamp(2.75rem, 5.5vw, 5.5rem) clamp(4rem, 7vw, 6.5rem) clamp(3rem, 6vw, 6rem); }
  :global([dir='rtl']) .blob-panel { transform: scaleX(-1); }
  :global([dir='rtl']) .blob-panel__inner, :global([dir='rtl']) .blob-panel__stripes { transform: scaleX(-1); }
  @media (max-width: 56.24rem) { .blob-panel__inner { padding: clamp(3.5rem, 14vw, 5rem) clamp(1.75rem, 8vw, 3rem) clamp(3.5rem, 14vw, 5rem) clamp(2rem, 9vw, 3.25rem); } }
  /* 1 · Hero: the brand gradient stage; the family film lives inside the label blob on the far side. */
  .h-hero { position: relative; isolation: isolate; overflow: clip; min-height: max(100svh, 44rem); display: flex; flex-direction: column; justify-content: center; padding-block: calc(var(--header-h) + 2.5rem) 4.5rem; background: var(--brand-gradient-diag); }
  .h-hero__mark { position: absolute; z-index: -1; inset-block: 0; inset-inline-end: 0; width: 60%; pointer-events: none; }
  .h-hero__stripes { position: absolute; width: 78%; height: auto; inset-inline-end: -6%; top: 6%; overflow: visible; opacity: 0.9; }
  .h-hero__film { position: absolute; inset: 8% -4% 8% 4%; -webkit-clip-path: url(#hero-blob); clip-path: url(#hero-blob); overflow: hidden; background: var(--navy-deep); }
  /* While the blob opens, the film passes in front of the fading copy; the toggle (z 3) stays above both. */
  .h-hero.is-opening .h-hero__mark { z-index: 1; }
  .h-hero__film-clip { position: absolute; width: 0; height: 0; }
  .h-hero__film video { width: 100%; height: 100%; object-fit: cover; object-position: 62% 50%; display: block; }
  :global([dir='rtl']) .h-hero__film video { transform: scaleX(-1); }
  .h-hero__drop { position: absolute; border-radius: 50%; background: var(--cyan); }
  .h-hero__drop--a { width: 1.1rem; height: 1.1rem; inset-inline-start: 2%; top: 22%; }
  .h-hero__drop--b { width: 0.5rem; height: 0.5rem; inset-inline-start: 7%; top: 29%; background: var(--cyan-stripe); }
  .h-hero__toggle {
    position: absolute; z-index: 3; inset-inline-end: var(--gutter); bottom: 1.5rem; display: grid; place-items: center;
    width: 3rem; height: 3rem; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.4); background: rgba(36, 54, 119, 0.6);
    color: #fff; cursor: pointer; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  .h-hero__toggle[hidden] { display: none; }
  .h-hero__toggle svg { width: 1.25rem; height: 1.25rem; fill: currentColor; }
  .h-hero__toggle .i-play { display: none; }
  .h-hero__toggle[aria-pressed='true'] .i-play { display: inline; }
  .h-hero__toggle[aria-pressed='true'] .i-pause { display: none; }
  .h-hero__toggle:hover { background: #fff; color: var(--navy); }
  .h-hero__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); align-items: center; position: relative; z-index: 2; }
  .h-hero__intro { grid-column: 1 / span 7; display: grid; justify-items: start; }
  .h-hero__title { font-size: clamp(2.5rem, 1.5rem + 4vw, 6rem); line-height: 1.02; letter-spacing: -0.025em; max-width: 18ch; }
  /* "names" is the word being reached for: cyan, and (in motion) it arrives a beat after its line. */
  .h-hero__title :global(.accent) { position: relative; display: inline-block; color: var(--cyan); }
  .h-hero__title :global(.accent)::after { content: ''; position: absolute; inset-inline: 0.04em; bottom: 0.1em; height: 0.06em; border-radius: 1em; background: currentColor; opacity: 0; transform: scaleX(0.3); transition: opacity 0.5s var(--ease), transform 0.7s var(--ease-out); }
  .h-hero__title :global(.accent.is-reaching)::after { opacity: 0.55; transform: scaleX(1); }
  /* The answer: one large statement, then a quieter supporting line. */
  .h-hero__answer { display: grid; gap: var(--s-2); max-width: 34rem; margin-block-start: var(--s-4); }
  .h-hero__statement { font-family: var(--font-display); font-size: clamp(1.625rem, 1.3rem + 1.1vw, 2.375rem); font-weight: 500; line-height: 1.18; letter-spacing: -0.02em; color: #fff; text-wrap: balance; }
  .h-hero__statement :global(.h-hero__love) { background: linear-gradient(var(--cyan), var(--cyan)) no-repeat 0 100% / var(--love, 100%) 0.08em; padding-block-end: 0.06em; }
  .h-hero__support { font-size: var(--fs-lead); line-height: 1.5; color: var(--on-dark-soft); text-wrap: pretty; }
  /* About the product: set apart by a hairline, smaller and calmer than the answer. */
  .h-hero__meta { position: relative; display: grid; gap: var(--s-3); justify-items: start; max-width: 34rem; margin-block-start: var(--s-5); padding-block-start: var(--s-3); }
  .h-hero__meta::before { content: ''; position: absolute; inset: 0 0 auto; height: 1px; background: var(--glass-line); transform: scaleX(var(--rule, 1)); transform-origin: 0 50%; }
  :global([dir='rtl']) .h-hero__meta::before { transform-origin: 100% 50%; }
  /* With motion, the hero copy waits (hidden, not removed) for its entrance, so the settled text never flashes first.
     Failsafe: if the script never starts, it appears after 4 s anyway. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .h-hero:not(.is-playing) :is(.h-hero__title, .h-hero__answer, .h-hero__meta) { visibility: hidden; animation: h-hero-failsafe 0s 4s forwards; }
  }
  @keyframes h-hero-failsafe { to { visibility: visible; } }
  .h-hero__lead { font-size: var(--fs-small); line-height: 1.6; color: var(--on-dark-soft); }
  /* The product, seen in the first frame: the official front-view bottle stands beside the product line, the actions
     and the licence line (below the divider, not beside the question). Official cutout only, never redrawn. */
  .h-hero__meta.has-bottle { grid-template-columns: auto minmax(0, 1fr); column-gap: clamp(1.25rem, 2vw, 2rem); max-width: 40rem; }
  .h-hero__meta.has-bottle > :not(.h-hero__bottle) { grid-column: 2; }
  .h-hero__bottle { grid-column: 1; grid-row: 1 / span 3; align-self: end; width: auto; height: clamp(10rem, 8rem + 6vw, 14rem); max-width: none; filter: drop-shadow(0 18px 24px rgba(20, 30, 80, 0.5)); }
  .h-hero__trust { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.9375rem; letter-spacing: 0.01em; color: var(--on-dark-mute); font-variant-numeric: tabular-nums; }
  .h-hero__trust::before { content: ''; width: 0.45rem; height: 0.45rem; flex: none; border-radius: 50%; background: var(--cyan); }
  /* The hero fits one screen on laptops too: type and spacing scale with the viewport height. */
  @media (min-width: 56.25rem) {
    .h-hero { min-height: 100svh; padding-block: calc(var(--header-h) + 1rem) 3rem; }
    .h-hero__title { font-size: min(clamp(2.5rem, 1.5rem + 4vw, 6rem), max(2.5rem, 8.5svh)); }
    .h-hero__statement { font-size: min(clamp(1.625rem, 1.3rem + 1.1vw, 2.375rem), max(1.5rem, 3.6svh)); }
    .h-hero__answer { margin-block-start: min(var(--s-4), 3svh); }
    .h-hero__meta { margin-block-start: min(var(--s-5), 4.5svh); }
    .h-hero__bottle { height: min(clamp(10rem, 8rem + 6vw, 14rem), 24svh); }
  }
  .h-cue { position: absolute; z-index: 2; bottom: 1.5rem; left: 50%; translate: -50% 0; width: 2px; height: 3.5rem; background: rgba(255, 255, 255, 0.15); border-radius: 2px; overflow: hidden; }
  .h-cue span { display: block; width: 100%; height: 40%; background: var(--cyan); }

  /* ============ Formulation story (3D) ============ */
  /* Resolved composition first (no JS / reduced motion): the chapters listed beside the closed capsule.
     While scrubbing, every chapter shares one cell and the scroll position decides which one is read. */
  .h-form { border-radius: var(--r-xl); margin-inline: clamp(0.5rem, 1.5vw, 1.5rem); overflow: clip; }
  .h-form__pin { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-block: calc(var(--header-h) + 1.5rem) 3rem; }
  /* The formulation stage carries no stripe field: the 3D scene is the only figure on its gradient (client request). */
  .h-form__pin.aurora::before { content: none; }
  .h-form__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); align-items: center; }
  .h-form__scene { display: contents; }
  .h-form__canvas {
    position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; display: block; pointer-events: none;
    opacity: 0; transition: opacity 0.9s ease;
  }
  .h-form.is-3d .h-form__canvas { opacity: 1; }
  .h-form__frame { grid-column: 7 / -1; grid-row: 1; position: relative; align-self: stretch; min-height: min(72svh, 44rem); }
  .h-form__poster { position: absolute; inset: 0; margin: auto; width: min(100%, 32rem); height: auto; max-height: 86%; transition: opacity 0.6s ease; }
  .h-form.is-3d .h-form__poster { opacity: 0; }

  .h-story { grid-column: 1 / span 6; grid-row: 1; position: relative; z-index: 2; display: grid; gap: var(--s-4); justify-items: start; }
  .h-story__title { font-size: clamp(2rem, 1.3rem + 2.4vw, 3.5rem); line-height: 1.04; letter-spacing: -0.022em; max-width: 18ch; color: #fff; text-wrap: balance; }
  .h-story__chapters { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4); width: 100%; }
  .h-chapter { display: grid; gap: 0.6rem; align-content: start; justify-items: start; }
  .h-chapter__n { font: 700 0.8125rem/1 var(--font-body); letter-spacing: 0.16em; color: var(--cyan-stripe); }
  .h-chapter__n span { color: rgba(255, 255, 255, 0.5); }
  .h-chapter__label { font: 650 clamp(1.375rem, 1.1rem + 0.8vw, 1.875rem)/1.1 var(--font-display); letter-spacing: -0.025em; color: #fff; max-width: 20ch; text-wrap: balance; }
  .h-chapter__body { max-width: 34rem; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); line-height: 1.55; color: var(--on-dark-soft); }
  .h-chapter__body :global(em) { font-style: italic; }
  .h-chapter .btn-row { margin-block-start: 0.5rem; }
  .h-story__rail { display: none; }

  @media (min-width: 56.25rem) {
    .h-form__pin { position: relative; isolation: isolate; }
    /* The scene fades out behind the reading column. */
    .h-form__canvas {
      -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.14) 0%, rgba(0, 0, 0, 0.14) 34%, #000 56%);
      mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.14) 0%, rgba(0, 0, 0, 0.14) 34%, #000 56%);
    }
    :global([dir='rtl']) .h-form__canvas {
      -webkit-mask-image: linear-gradient(270deg, rgba(0, 0, 0, 0.14) 0%, rgba(0, 0, 0, 0.14) 34%, #000 56%);
      mask-image: linear-gradient(270deg, rgba(0, 0, 0, 0.14) 0%, rgba(0, 0, 0, 0.14) 34%, #000 56%);
    }
    .h-form__frame { position: sticky; top: calc(var(--header-h) + 1rem); }
    :global(.h-form.is-scrubbing) .h-form__frame { position: relative; top: auto; }
  }

  /* ---- Scrubbing: one chapter at a time, set like a film title card. The outgoing card lifts away at once (up when
     scrolling on, down when scrolling back); the incoming one follows a beat later, its number, title, text and
     actions rising in turn, so the two cards never overlap. ---- */
  :global(.h-form.is-scrubbing) .h-story__chapters { grid-template-columns: minmax(0, 1fr); gap: 0; }
  :global(.h-form.is-scrubbing) .h-chapter { grid-area: 1 / 1; gap: 1rem; pointer-events: none; }
  :global(.h-form.is-scrubbing) .h-chapter > * { opacity: 0; translate: 0 1rem; transition: opacity 0.36s ease-in, translate 0.42s ease-in; }
  :global(.h-form.is-scrubbing) .h-chapter[data-state='past'] > * { translate: 0 -0.85rem; }
  :global(.h-form.is-scrubbing) .h-chapter[data-state='active'] { pointer-events: auto; }
  :global(.h-form.is-scrubbing) .h-chapter[data-state='active'] > * {
    opacity: 1; translate: 0 0;
    transition: opacity 0.8s ease-out var(--in, 0.34s), translate 1.2s cubic-bezier(0.2, 0.75, 0.2, 1) var(--in, 0.34s);
  }
  .h-chapter > :nth-child(2) { --in: 0.44s; }
  .h-chapter > :nth-child(3) { --in: 0.56s; }
  .h-chapter > :nth-child(4) { --in: 0.68s; }
  :global(.h-form.is-scrubbing) .h-chapter__label { font-size: clamp(2rem, 1.3rem + 2.2vw, 3.25rem); line-height: 1.04; max-width: 16ch; text-shadow: 0 2px 28px rgba(36, 54, 119, 0.6); }
  :global(.h-form.is-scrubbing) .h-story__title { font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem); line-height: 1.12; max-width: 26ch; }
  :global(.h-form.is-scrubbing) .h-story__rail { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; width: min(100%, 22rem); }
  .h-story__rail span { position: relative; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, 0.18); overflow: hidden; }
  .h-story__rail span::after { content: ''; position: absolute; inset: 0; background: var(--cyan); transform-origin: 0 50%; transform: scaleX(var(--fill, 0)); }
  :global([dir='rtl']) .h-story__rail span::after { transform-origin: 100% 50%; }

  /* ============ Why ============ */
  /* 2 · Why: a full-width research subject, then photo and reading column. */
  .h-why { position: relative; padding-block: var(--section); }
  .h-why__grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto auto 1fr; column-gap: clamp(1rem, 2.5vw, 2.5rem); align-items: start; }
  .h-why__heading { grid-column: 1 / -1; grid-row: 1; min-width: 0; }
  .h-why__title { max-width: 17ch; font-size: clamp(2.75rem, 1rem + 5.2vw, 6.5rem); line-height: 1; letter-spacing: -0.028em; }
  .h-why__context { display: block; margin-block-end: var(--s-3); font: 600 clamp(1.125rem, 1rem + 0.45vw, 1.4rem)/1.4 var(--font-body); letter-spacing: 0; color: var(--ink-soft); }
  .h-why__title :global(.accent) { color: var(--blue-bright); }
  .h-why__photo { grid-column: 1 / span 5; grid-row: 2 / span 2; min-width: 0; margin-block-start: clamp(3rem, 6vw, 6rem); }
  .h-why__photo :global(.photo) { border-radius: var(--r-m); border-start-start-radius: clamp(3rem, 6vw, 6rem); box-shadow: none; }
  .h-why__body { grid-column: 7 / span 6; grid-row: 2; display: grid; gap: var(--s-5); max-width: 36rem; min-width: 0; margin-block-start: clamp(3rem, 6vw, 6rem); color: var(--ink-soft); font-size: var(--fs-body); line-height: var(--lh-body); }
  .h-why__paragraph :global(p + p) { margin-block-start: 1em; }
  .h-why__paragraph :global(.h-why__moment) { color: var(--ink); font-weight: 600; }
  /* The research caveat: a pull statement. */
  .h-why__note { font-family: var(--font-display); font-size: clamp(1.5rem, 1.2rem + 1vw, 2.25rem); font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; color: var(--ink); text-wrap: balance; }
  .h-why__footer { grid-column: 7 / span 6; grid-row: 3; align-self: start; display: grid; gap: var(--s-2); justify-items: start; max-width: 36rem; margin-block-start: var(--s-5); border-block-start: 1px solid var(--line-strong); padding-block-start: var(--s-3); }
  .h-why__footer :global(.text-link) { font-size: 1rem; }
  .h-why__footer :global(.sources) { font-size: 0.875rem; overflow-wrap: anywhere; }
  .h-why__grid--text { grid-template-columns: minmax(0, 1fr); max-width: calc(48rem + 2 * var(--gutter)); }
  .h-why__grid--text > * { grid-column: 1; }

  /* ============ Who: a contact sheet resolves into four research portraits ============ */
  .h-who { padding-block: var(--section); }
  .h-who__layout { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(3rem, 6vw, 6rem); align-items: start; }
  .h-who__head { display: grid; gap: var(--s-2); }
  .h-who__head h2 { max-width: 17ch; font-size: clamp(2.5rem, 1.4rem + 2.7vw, 4rem); line-height: 1.03; letter-spacing: -0.025em; }
  .h-who__intro { display: grid; gap: 0.5rem; justify-items: start; }
  .h-who__intro :global(.lead) { font-size: var(--fs-body); line-height: var(--lh-body); }
  .h-who__fact { display: flex; align-items: baseline; gap: 0.6rem; margin-block-start: 0.75rem; font-size: 0.875rem; line-height: 1.5; letter-spacing: 0.01em; color: var(--ink-soft); }
  .h-who__fact::before { content: ''; flex: none; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--cyan); transform: translateY(-0.1em); }
  .h-who__gallery { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 0.5rem; height: clamp(17rem, 32svh, 22rem); margin-block-start: var(--s-2); }
  .h-who__frame { position: relative; min-width: 0; min-height: 0; overflow: hidden; border-radius: var(--r-m); }
  .h-who__frame :global(.photo) { width: 100%; height: 100%; border-radius: inherit; box-shadow: none; }
  .h-who__frame :global(.photo img) { object-position: var(--who-focus); }
  .h-who__list { list-style: none; margin: 0; padding: 0; }
  .h-who__entry { display: grid; align-content: center; gap: var(--s-3); padding-block: var(--s-5); }
  .h-who__detail { display: grid; gap: var(--s-3); }
  .h-who__detail h3 { max-width: 18ch; font-size: clamp(2rem, 1.3rem + 1.8vw, 3rem); line-height: 1.1; letter-spacing: -0.02em; }
  .h-who__detail p { color: var(--ink-soft); font-size: var(--fs-lead); line-height: 1.6; max-width: 35ch; }
  .h-who__mobile-photo { display: none; }
  :global(.h-who.is-story) { --who-stage-h: min(60rem, calc(100svh - var(--header-h) - 2rem)); }
  :global(.h-who.is-story) .h-who__head { position: sticky; top: calc(var(--header-h) + 1rem); height: var(--who-stage-h); grid-template-rows: auto auto minmax(0, 1fr); }
  :global(.h-who.is-story) .h-who__gallery { height: auto; }
  :global(.h-who.is-story) .h-who__entry { display: block; align-content: start; min-height: var(--who-stage-h); padding-block-start: var(--who-entry-inset); }
  :global(.h-who.is-story) .h-who__entry:not(:last-child) { margin-block-end: calc(-1 * var(--who-entry-inset)); }
  :global(.h-who.is-story) .h-who__detail { position: sticky; top: var(--who-detail-top); }
  :global(.h-who.is-story) .h-who__entry:last-child .h-who__detail { position: static; }
  :global(.h-who__gallery.is-focused) { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: minmax(0, 1fr) 4.5rem; }
  :global(.h-who__gallery.is-focused) .h-who__frame { grid-row: 2; border-radius: var(--r-s); }
  :global(.h-who__gallery.is-focused) :global(.h-who__frame.is-active) { grid-column: 1 / -1; grid-row: 1; border-radius: var(--r-m); }

  /* ============ Evidence: a dark ground with colour fields; the main result sits on one glass panel ============ */
  /* 5 · Evidence: a pale stage; the result lives inside the label blob. */
  .h-evidence { position: relative; isolation: isolate; overflow: clip; padding-block: var(--section); background: var(--paper-2); }
  .h-evidence__grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); align-items: center; }
  .h-evidence__intro { grid-column: 1 / span 5; display: grid; gap: var(--s-4); align-content: center; min-width: 0; color: var(--ink); }
  .h-evidence__title { max-width: 11ch; font-size: clamp(2.5rem, 1.25rem + 3.4vw, 4.75rem); line-height: 1.02; letter-spacing: -0.028em; }
  .h-evidence__lead { max-width: 30rem; color: var(--ink-soft); font-size: var(--fs-lead); line-height: 1.5; }
  .h-evidence__more { display: grid; gap: var(--s-4); }
  .h-evidence__rule { display: block; height: 1px; background: var(--line-strong); transform-origin: 0 50%; }
  :global([dir='rtl']) .h-evidence__rule { transform-origin: 100% 50%; }
  .h-evidence__more p { max-width: 30rem; color: var(--ink-soft); font-size: var(--fs-body); }
  /* The shape curves in at its top-start corner, so the top and start padding are deeper than the rest. */
  .h-evidence__panel { grid-column: 6 / span 7; min-width: 0; color: var(--on-dark); }
  .h-evidence__inner { display: grid; gap: var(--s-3); }
  .h-evidence__kicker { font: 700 0.875rem/1.2 var(--font-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--cyan); }
  .h-evidence__figure { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.25rem 1rem; }
  .h-evidence__number { font: 600 clamp(5rem, 2.5rem + 7.5vw, 10rem)/0.86 var(--font-display); letter-spacing: -0.045em; color: #fff; font-variant-numeric: tabular-nums; }
  .h-evidence__unit { max-width: 9ch; padding-block-end: 0.5em; font: 600 clamp(1.125rem, 1rem + 0.5vw, 1.5rem)/1.15 var(--font-display); color: var(--cyan); }
  .h-evidence__result { max-width: 34ch; color: #fff; font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.625rem); line-height: 1.45; font-weight: 500; }
  .h-evidence__result :global(mark.figure) { background: none; color: var(--cyan); font-weight: 700; }
  .h-evidence__explain { color: var(--on-dark-soft); font-size: var(--fs-body); }
  .h-evidence__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3) var(--s-4); margin: var(--s-1) 0 0; padding-block-start: var(--s-4); border-block-start: 1px solid rgba(255, 255, 255, 0.2); }
  .h-evidence__facts dt { font: 600 clamp(1.25rem, 1.1rem + 0.4vw, 1.5rem)/1.2 var(--font-display); color: #fff; }
  .h-evidence__facts dd { margin: 0.25rem 0 0; color: var(--on-dark-soft); font-size: 1rem; line-height: 1.45; }
  .h-evidence__source { font-size: 0.875rem; overflow-wrap: anywhere; }

  /* ============ How to take it: one view — the day (left) and the eight-week panel (right) ============ */
  .h-dir { position: relative; overflow-x: clip; padding-block: var(--section); }
