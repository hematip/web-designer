---
// Article template — the eight parts from brief Part 4 (MEMORY HEALTH):
// 1 title · 2 one-sentence summary · 3 category · 4 published + last-reviewed dates · 5 body
// 6 Sources with DOIs · 7 fixed line · 8 related page link. Plus author (brief Part 7).
import Base from '../layouts/Base.astro';
import Sources from '../components/Sources.astro';
import Action from '../components/Action.astro';
import Pending from '../components/Pending.astro';
import ProBand from '../components/ProBand.astro';
import { getPage, getSite, section, href, md, getArticlesWithFallback, doiUrl } from '../lib/content.js';

const { locale, routePath, slug } = Astro.props;
const { data: blog } = getPage(locale, 'memory-health');
const ui = getSite(locale).data.ui;
const { list, fallback } = getArticlesWithFallback(locale);
const a = list.find((x: any) => x.slug === slug);
const cat = (blog.categories ?? []).find((c: any) => c.slug === a.category);
const fixedLine = section(blog, 'article-template').fixed_line;
const title = `${a.title} | Memowell`;
---
<Base locale={locale} routePath={routePath} title={title} description={a.meta_description || a.summary} fallback={fallback} status={a.status}>
  <article class="article">
    <header class="article__head is-dark aurora" data-pointer><div class="wrap article__head-inner">
      <nav class="breadcrumb" aria-label={ui.breadcrumb}>
        <ol>
          <li><a href={href(locale, '/')}>{ui.home}</a></li>
          <li><a href={href(locale, '/memory-health')}>{blog.sections[0].heading}</a></li>
          {cat && <li><a href={href(locale, `/memory-health/category/${cat.slug}`)}>{cat.label}</a></li>}
        </ol>
      </nav>
      {cat && <p class="article__cat"><span class="visually-hidden">{ui.category}: </span>{cat.label}</p>}
      <h1 data-split="load">{a.title}</h1>
      {a.summary ? <p class="lead article__summary">{a.summary}</p> : <Pending label="one-sentence summary" />}
      <dl class="article__meta">
        {a.author ? <div><dt>{ui.author}</dt><dd>{a.author}</dd></div> : null}
        {a.published ? <div><dt>{ui.published}</dt><dd><time datetime={a.published}>{a.published}</time></dd></div> : null}
        {a.last_reviewed ? <div><dt>{ui.last_reviewed}</dt><dd><time datetime={a.last_reviewed}>{a.last_reviewed}</time></dd></div> : null}
      </dl>
      {(!a.author || !a.published || !a.last_reviewed) && <Pending label="author, published date and last-reviewed date" />}
    </div></header>

    <div class="wrap article__body">
      {a.body
        ? <div class="prose article__prose" set:html={md(a.body)} />
        : <Pending label="article body" detail={`Not written — must not be invented. Built from: ${a.built_from}. Needs scientific-officer approval before publication.`} />}

      {a.sources?.length > 0 && (
        <section class="article__sources" aria-labelledby="sources-title">
          <h2 id="sources-title" class="h3">{ui.sources_heading}</h2>
          <ul>{a.sources.map((d: string) => <li><a href={doiUrl(d)} rel="noopener">DOI {d}</a></li>)}</ul>
        </section>
      )}

      <p class="article__fixed"><em>{fixedLine}</em></p>

      {a.related && (
        <p class="article__related"><span class="muted">{ui.related}: </span><Action action={a.related} locale={locale} variant="link" /></p>
      )}
    </div>
  </article>
  <ProBand locale={locale} />
</Base>

<style>
  .article__head { padding-block: calc(var(--header-h) + clamp(3rem, 2rem + 4vw, 6rem)) clamp(3rem, 2rem + 3vw, 5rem); margin: 0 clamp(0.5rem, 1.5vw, 1.5rem); border-radius: 0 0 var(--r-xl) var(--r-xl); }
  .article__head-inner { display: grid; gap: var(--s-3); justify-items: start; max-width: calc(54rem + 2 * var(--gutter)); }
  .article__cat { padding: 0.35rem 0.85rem; border-radius: 999px; background: var(--glass); border: 1px solid var(--glass-line); font-weight: 700; color: #fff; }
  .article h1 { font-size: clamp(2.25rem, 1.5rem + 3vw, 4.25rem); max-width: 22ch; letter-spacing: -0.025em; }
  .article__summary { color: var(--on-dark-soft); }
  .article__meta { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); margin: 0; font-size: 1rem; }
  .article__meta div { display: flex; gap: 0.4rem; }
  .article__meta dt { font-weight: 700; color: #fff; }
  .article__meta dd { margin: 0; color: var(--on-dark-soft); }
  .article__body { display: grid; gap: var(--s-4); padding-block: var(--section); max-width: calc(48rem + 2 * var(--gutter)); }
  .article__prose { max-width: var(--measure); font-size: var(--fs-lead); }
  .article__sources { border-top: 1px solid var(--line); padding-block-start: var(--s-3); display: grid; gap: var(--s-2); }
  .article__sources ul { margin: 0; padding-inline-start: 1.2em; }
  .article__sources a { overflow-wrap: anywhere; }
  .h3 { font-size: var(--fs-h3); }
  .article__fixed { padding: var(--s-4); background: #fff; border: 1px solid var(--line); border-radius: var(--r-l); max-width: var(--measure); }
</style>
