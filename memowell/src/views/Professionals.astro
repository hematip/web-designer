---
// The professional section, in the home page's language (2026-11-25): an index row under the photograph, then the
// sections as numbered open entries parted by hairlines; the studies table and chart keep their own forms. Copy unchanged.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Sources from '../components/Sources.astro';
import Action from '../components/Action.astro';
import Form from '../components/Form.astro';
import Pending from '../components/Pending.astro';
import Photo from '../components/Photo.astro';
import TrialChart from '../components/TrialChart.astro';
import { getPage, getSite, section, md, mdInline, doiUrl, photoOf } from '../lib/content.js';

const { locale, routePath } = Astro.props;
const { data: page, fallback } = getPage(locale, 'professionals');
const site = getSite(locale).data;
const ui = site.ui;
const navLabel = site.nav.find((n: any) => n.href === '/science')?.label;
const s = (id: string) => section(page, id);
const entrance = s('entrance'), evidenceIntro = s('evidence-intro'), studies = s('studies'), narrative = s('studies-narrative'), composition = s('composition'), monitoring = s('monitoring'), mechanism = s('mechanism'), withMeds = s('with-medicines'), cases = s('case-reports'), q = s('question-form'), fb = s('feedback-form');
const photo = photoOf(locale, 'professionals', 'entrance');
// The reading order; each entry is numbered on the page and in the index.
const entries = [
  evidenceIntro?.heading && { id: 'evidence', title: evidenceIntro.heading },
  { id: 'studies', title: studies.heading },
  narrative?.heading && { id: 'studies-narrative', title: narrative.heading },
  { id: 'composition', title: composition.heading },
  mechanism?.heading && { id: 'mechanism', title: mechanism.heading },
  { id: 'monitoring', title: monitoring.heading },
  withMeds?.heading && { id: 'with-medicines', title: withMeds.heading },
  { id: 'case-reports', title: cases.heading },
].filter(Boolean) as { id: string; title: string }[];
const n = (id: string) => `${String(entries.findIndex((e) => e.id === id) + 1).padStart(2, '0')}<span> / ${String(entries.length).padStart(2, '0')}</span>`;
---
<Base locale={locale} routePath={routePath} title={page.meta_title} description={page.meta_description} fallback={fallback} status={page.status} bodyClass="page-pro">
  <PageHead locale={locale} title={entrance.heading} body={entrance.body} note={entrance.note} accent="Memowell®" kicker={navLabel} wide />
  {photo && <div class="wrap pro-photo ed-photo" data-reveal><Photo photo={photo} variant="wide" sizes="(min-width: 90rem) 1360px, 94vw" /></div>}

  <nav class="wrap pro-index ed-index" aria-labelledby="otp-title">
    <p id="otp-title" class="ed-index__title">{ui.on_this_page}</p>
    <ol role="list">{entries.map((e, i) => <li><a href={`#${e.id}`}><span class="idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{e.title}</a></li>)}</ol>
  </nav>

  <div class="wrap pro-entries ed-entries">
    {evidenceIntro?.heading && (
      <section class="ed-entry pro-entry" id="evidence" aria-labelledby="evidence-title" data-reveal>
        <p class="ed-num" set:html={n('evidence')} />
        <h2 id="evidence-title">{evidenceIntro.heading}</h2>
        <div class="prose" set:html={md(evidenceIntro.body)} />
      </section>
    )}

    <section class="ed-entry pro-entry pro-entry--wide" id="studies" aria-labelledby="studies-title">
      <p class="ed-num" set:html={n('studies')} data-reveal />
      <h2 id="studies-title" data-reveal>{studies.heading}</h2>
      <div class="table-wrap" data-reveal>
        <table class="studies-table">
          <caption id="studies-caption" class="visually-hidden">{studies.columns.join(', ')}</caption>
          <colgroup><col class="c-study" /><col class="c-pop" /><col class="c-design" /><col class="c-find" /><col class="c-src" /></colgroup>
          <thead>
            <tr>{studies.columns.map((c: string) => <th scope="col">{c}</th>)}</tr>
          </thead>
          <tbody>
            {studies.rows.map((r: any) => (
              <tr>
                <th scope="row" data-label={studies.columns[0]} set:html={mdInline(r.study)} />
                <td data-label={studies.columns[1]}>{r.population}</td>
                <td data-label={studies.columns[2]}>{r.design}</td>
                <td data-label={studies.columns[3]}>{r.findings}</td>
                <td data-label={studies.columns[4]}>
                  <ul class="doi-list" role="list">
                    {r.sources.map((d: string) => <li><a href={doiUrl(d)} rel="noopener">DOI {d}</a></li>)}
                  </ul>
                  {r.citation && <p class="cite">{r.citation}</p>}
                  {r.publisher_url && <p class="small"><a href={r.publisher_url} rel="noopener">Publisher</a></p>}
                  {r.free_full_text_url && <p class="small"><a href={r.free_full_text_url} rel="noopener">Full text</a></p>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {narrative?.heading && (
      <section class="ed-entry pro-entry pro-entry--wide" id="studies-narrative" aria-labelledby="narrative-title" data-reveal>
        <p class="ed-num" set:html={n('studies-narrative')} />
        <h2 id="narrative-title">{narrative.heading}</h2>
        <div class="prose" set:html={md(narrative.body)} />
        {narrative.chart_caption && <div class="pro-chart"><TrialChart caption={narrative.chart_caption} /></div>}
        <Sources dois={narrative.sources} locale={locale} />
      </section>
    )}

    <section class="ed-entry pro-entry" id="composition" aria-labelledby="comp-title" data-reveal>
      <p class="ed-num" set:html={n('composition')} />
      <h2 id="comp-title">{composition.heading}</h2>
      <div class="prose spec" set:html={md(composition.body)} />
    </section>

    {mechanism?.heading && (
      <section class="ed-entry pro-entry" id="mechanism" aria-labelledby="mech-title" data-reveal>
        <p class="ed-num" set:html={n('mechanism')} />
        <h2 id="mech-title">{mechanism.heading}</h2>
        <div class="prose" set:html={md(mechanism.body)} />
        <Sources dois={mechanism.sources} locale={locale} />
      </section>
    )}

    <section class="ed-entry pro-entry" id="monitoring" aria-labelledby="mon-title" data-reveal>
      <p class="ed-num" set:html={n('monitoring')} />
      <h2 id="mon-title">{monitoring.heading}</h2>
      <div class="prose" set:html={md(monitoring.body)} />
      <Sources dois={monitoring.sources} locale={locale} />
    </section>

    {withMeds?.heading && (
      <section class="ed-entry pro-entry" id="with-medicines" aria-labelledby="meds-title" data-reveal>
        <p class="ed-num" set:html={n('with-medicines')} />
        <h2 id="meds-title">{withMeds.heading}</h2>
        <div class="prose" set:html={md(withMeds.body)} />
      </section>
    )}

    <section class="ed-entry pro-entry" id="case-reports" aria-labelledby="cases-title" data-reveal>
      <p class="ed-num" set:html={n('case-reports')} />
      <h2 id="cases-title">{cases.heading}</h2>
      <div class="prose" set:html={md(cases.body)} />
      <div class="btn-row">{cases.actions.map((a: any) => <Action action={a} locale={locale} variant="secondary" />)}</div>
    </section>
  </div>

  <div class="wrap pro-forms">
    <div class="pro-form" id="scientific-question" data-reveal>
      <h2 id="q-title">{q.heading}</h2>
      <div class="prose" set:html={md(q.body)} />
      <Form form={q.form} locale={locale} labelledby="q-title" />
    </div>
    <div class="pro-form" id="report-observation" data-reveal>
      <h2 id="fb-title">{fb.heading}</h2>
      <div class="prose" set:html={md(fb.body)} />
      <Form form={fb.form} locale={locale} labelledby="fb-title" />
    </div>
  </div>
</Base>

<style>
  .pro-photo { position: relative; z-index: 2; margin-block: calc(-1 * clamp(2.5rem, 2rem + 2.5vw, 4.5rem)) clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .pro-photo :global(.photo) { border-start-end-radius: var(--r-m); border-end-end-radius: clamp(3rem, 6vw, 6rem); }
  /* The index: equal pills in a grid (the headings are long questions), two to a row on wide screens, one on phones. */
  .pro-index { padding-block: var(--s-4) 0; }
  .pro-index ol { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; max-width: 60rem; }
  .pro-index li { min-width: 0; }
  .pro-index a { align-items: center; min-height: 3.75rem; padding-block: 0.7rem; font-size: 1rem; line-height: 1.25; text-wrap: pretty; }
  .pro-entries { padding-block: var(--s-5) 0; }
  .pro-entry { padding-block: var(--s-6); }
  .pro-entry > h2 { max-width: 22ch; }
  .pro-entry > :global(.prose) { max-width: 52rem; }
  .pro-entry--wide { width: 100%; }
  .pro-chart { width: 100%; max-width: 60rem; }

  .table-wrap { width: 100%; border: 1px solid var(--line); border-radius: var(--r-l); overflow: hidden; background: #fff; }
  .studies-table { width: 100%; border-collapse: collapse; font-size: 1.0625rem; line-height: 1.5; table-layout: fixed; }
  .studies-table col.c-study { width: 15%; } .studies-table col.c-pop { width: 16%; } .studies-table col.c-design { width: 19%; }
  .studies-table col.c-find { width: 25%; } .studies-table col.c-src { width: 25%; }
  .studies-table th, .studies-table td { text-align: start; vertical-align: top; padding: 1.25rem 1.2rem; border-bottom: 1px solid var(--line); }
  .studies-table thead th { background: var(--navy); color: #fff; font: 700 0.9375rem/1.3 var(--font-body); letter-spacing: 0.06em; text-transform: uppercase; }
  .studies-table tbody th { font-weight: 700; font-family: var(--font-display); font-size: 1.125rem; }
  .studies-table tbody tr:last-child > * { border-bottom: 0; }
  .studies-table tbody tr:hover { background: var(--paper-2); }
  .doi-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; }
  .doi-list a { overflow-wrap: anywhere; font-size: 1rem; font-variant-numeric: tabular-nums; }
  .cite { margin-block-start: 0.5rem; color: var(--ink-soft); font-size: 1rem; }

  .spec :global(p) { padding-block: 0.9rem; border-bottom: 1px solid var(--line); margin: 0; }
  .spec :global(p:last-child) { border-bottom: 0; color: var(--ink-soft); }

  .pro-forms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); padding-block: var(--s-5) var(--section); }
  .pro-form { display: grid; gap: var(--s-3); align-content: start; justify-items: start; padding-block-start: var(--s-5); border-block-start: 1px solid var(--line-strong); }
  .pro-form h2 { max-width: 16ch; font-size: clamp(1.875rem, 1.3rem + 1.8vw, 3rem); line-height: 1.1; letter-spacing: -0.022em; }

  @media (max-width: 63.99rem) {
    .pro-forms { grid-template-columns: 1fr; }
    .pro-index ol { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 52rem) {
    .table-wrap { border: 0; background: none; border-radius: 0; }
    .studies-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .studies-table, .studies-table tbody, .studies-table tr, .studies-table th, .studies-table td { display: block; width: auto !important; }
    .studies-table tr { background: #fff !important; border: 1px solid var(--line); border-radius: var(--r-l); margin-block-end: var(--s-2); padding: 0.5rem 0; }
    .studies-table tbody th, .studies-table td { border-bottom: 1px solid var(--line); padding: 0.75rem 1.2rem; }
    .studies-table tbody th::before, .studies-table td::before { content: attr(data-label); display: block; font: 700 0.875rem/1.3 var(--font-body); letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-soft); margin-block-end: 0.2rem; }
  }
</style>
