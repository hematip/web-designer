---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Action from '../components/Action.astro';
import Form from '../components/Form.astro';
import { getPage, getSite, section, md } from '../lib/content.js';

const { locale, routePath } = Astro.props;
const { data: page, fallback } = getPage(locale, 'partners');
const intro = section(page, 'intro');
const form = section(page, 'form');
const nav = getSite(locale).data.nav;
const about = nav.find((n: any) => n.href === '/about');
const crumbs = [{ label: about?.label ?? 'About', href: '/about' }];
---
<Base locale={locale} routePath={routePath} title={page.meta_title} description={page.meta_description} fallback={fallback} status={page.status}>
  <PageHead locale={locale} title={intro.heading} crumbs={crumbs} wide />

  <section class="section--tight" aria-labelledby="partner-spec">
    <div class="wrap partner-grid">
      <div class="partner-spec card" id="partner-spec" aria-label={intro.heading}>
        <div class="prose spec" set:html={md(intro.body)} />
        <div class="btn-row">{intro.actions.map((a: any) => <Action action={a} locale={locale} variant="secondary" />)}</div>
      </div>
      <figure class="partner-photo">
        <img src="/img/bottle-in-hand-1000.webp" srcset="/img/bottle-in-hand-640.webp 640w, /img/bottle-in-hand-1000.webp 1000w" sizes="(min-width: 64rem) 420px, 92vw" width="1000" height="1333" alt={intro.image_alt} loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="section partner-form" id="talk" aria-labelledby="talk-title">
    <div class="wrap partner-form__inner">
      <h2 id="talk-title">{form.heading}</h2>
      <div class="prose" set:html={md(form.body)} />
      <Form form={form.form} locale={locale} labelledby="talk-title" />
    </div>
  </section>
</Base>

<style>
  .partner-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); align-items: start; padding-block-end: var(--s-5); }
  .partner-spec { grid-column: 1 / span 7; display: grid; gap: var(--s-4); }
  .spec :global(p) { padding-block: 0.6rem; }
  .spec :global(p + p) { border-top: 1px solid var(--line); padding-block-start: 1.2rem; }
  .partner-photo { grid-column: 9 / span 4; border-radius: var(--radius-l); overflow: hidden; aspect-ratio: 3 / 4; }
  .partner-photo img { width: 100%; height: 100%; object-fit: cover; }
  .partner-form { background: var(--paper-2); }
  .partner-form__inner { display: grid; gap: var(--s-3); }
  @media (max-width: 63.99rem) {
    .partner-spec, .partner-photo { grid-column: 1 / -1; }
    .partner-photo { margin-block-start: var(--s-4); max-width: 26rem; }
  }
</style>
