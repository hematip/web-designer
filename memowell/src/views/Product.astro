---
// Product page (2026-11-28, bex-web-design): "inside the capsule". The signature scene is the real capsule: it parts
// as the composition is read and the three ingredients rise out of the gap; it then travels into step 01 of
// "How to take it" and stays there (product-scenes.js). Open sections on hairlines, the label's photo corner, pull
// statements; copy unchanged. Reduced motion and no-JS: the resolved composition.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import BottleStage from '../components/BottleStage.astro';
import Action from '../components/Action.astro';
import Note from '../components/Note.astro';
import Pending from '../components/Pending.astro';
import ProductDisclaimer from '../components/ProductDisclaimer.astro';
import ProBand from '../components/ProBand.astro';
import Icon from '../components/Icon.astro';
import Capsule from '../components/Capsule.astro';
import Photo from '../components/Photo.astro';
import { getPage, getSite, section, md, photoOf } from '../lib/content.js';

const { locale, routePath } = Astro.props;
const { data: page, fallback } = getPage(locale, 'memowell');
const site = getSite(locale).data;
const navLabel = site.nav.find((n: any) => n.href === '/memowell')?.label;
const s = (id: string) => section(page, id);
const intro = s('intro'), composition = s('composition'), directions = s('directions'), cautions = s('cautions'), storage = s('storage'), summary = s('summary');
const directionsPhoto = photoOf(locale, 'memowell', 'directions');
const compositionPhoto = photoOf(locale, 'memowell', 'composition');
const glutenPhoto = photoOf(locale, 'memowell', 'gluten');
// The gluten note: its first line (bold) is the section heading, the rest the body.
const glutenParts = (composition.gluten ?? '').split(/\n\s*\n/);
const glutenHeading = glutenParts[0]?.replace(/^\*\*|\*\*$/g, '') ?? '';
const glutenBody = glutenParts.slice(1).join('\n\n');
const accent = (t: string) => t.includes('Memowell®') ? t.replace('Memowell®', '<span class="accent">Memowell®</span>') : t;
const num = (i: number, n = 5) => `${String(i).padStart(2, '0')}<span> / ${String(n).padStart(2, '0')}</span>`;
// The three ingredients, as named in the approved composition sentence; the amount from the approved per-capsule line.
// Three cards beside the photograph; the bar is the approved standardisation ("standardised to 40% boswellic acids").
const ingredients = composition.ingredients ?? [
  { name: 'K-Vie™ boswellic acids', note: composition.per_capsule_amount ? '333 mg per capsule' : '', bar: { value: 40, label: '40% boswellic acids' } },
  { name: 'Bacosides from Bacopa', note: '' },
  { name: 'Vitamin D3', note: '' },
];
---
<Base locale={locale} routePath={routePath} title={page.meta_title} description={page.meta_description} fallback={fallback} status={page.status} bodyClass="page-product">
  <PageHead locale={locale} title={intro.heading} body={intro.body} accent="Memowell®" kicker={navLabel}>
    <BottleStage slot="media" id="product" alt={intro.image_alt} />
  </PageHead>

  <!-- 1 · What's inside (2026-11-28, after an Untitled UI section: copy on the start side; on the end side a tall
       photograph with one arched corner, floating detail cards over its lower start edge, and a quiet pattern behind
       its far corner). Here: the capsule-and-resin photograph with the label's corner, the three ingredients as cards
       (the K-Vie™ card carries the approved amount and the 40% standardisation as a bar), and the label's stripe blob
       behind the far corner. With motion the cards rise in one after another as the section is read. -->
  <section class="section p-sec p-inside" id="composition" aria-labelledby="composition-title" data-inside>
    <div class="wrap p-inside__grid">
      <div class="p-copy p-inside__copy">
        <p class="ed-num" data-reveal set:html={num(1)} />
        <h2 id="composition-title" class="ed-title" data-split set:html={accent(composition.heading)} />
        <div class="prose" data-reveal set:html={md(composition.body)} />
        {composition.per_capsule_amount
          ? <p class="ed-pull p-amount" data-reveal>{composition.per_capsule_amount}</p>
          : <Pending label="amount of active ingredient per capsule" detail="Not supplied by the client (brief Part 9). Shown here once confirmed." />}
      </div>
      <div class="p-inside__side">
        <div class="p-inside__stage">
          <div class="p-inside__pattern" aria-hidden="true"><svg viewBox="0 0 440 330" focusable="false"><defs><pattern id="inside-stripes" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)"><rect width="3.2" height="9" fill="var(--cyan-stripe)" /></pattern></defs><path fill="url(#inside-stripes)" d="M232 40C300 24 384 56 398 124C412 192 364 264 300 286C236 308 160 284 128 228C96 172 164 56 232 40Z" /></svg></div>
          {compositionPhoto && <div class="p-inside__photo" data-reveal><Photo photo={compositionPhoto} variant="portrait" sizes="(min-width: 64rem) 520px, 92vw" /></div>}
          <ul class="ing-cards" role="list" aria-label={composition.heading}>
            {ingredients.map((it: any, i: number) => (
              <li class="ing-card" data-ing-card style={`--i: ${i}`}>
                <span class="ing-card__icon" aria-hidden="true"><Capsule id={`ing-cap-${i}`} /></span>
                <span class="ing-card__body">
                  <span class="ing-card__name">{it.name}</span>
                  {it.note && <span class="ing-card__note">{it.note}</span>}
                  {it.bar && <span class="ing-card__bar" role="img" aria-label={it.bar.label}><span class="ing-card__fill" style={`--w: ${it.bar.value}%`}></span><span class="ing-card__pct">{it.bar.label}</span></span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · How to take it: the photograph, then three steps on hairlines; the capsule from above lands in step 01. -->
  <section class="section p-sec directions" id="directions" aria-labelledby="directions-title">
    <div class="wrap">
      <div class="ed-head" data-reveal>
        <p class="ed-num" set:html={num(2)} />
        <h2 id="directions-title" class="ed-title">{directions.heading}</h2>
      </div>
      {directionsPhoto && <div class="directions__photo ed-photo" data-reveal><Photo photo={directionsPhoto} variant="landscape" sizes="(min-width: 90rem) 1360px, 94vw" /></div>}
      <ol class="steps" role="list">
        {directions.items.map((item: any, i: number) => (
          <li class="step" data-reveal>
            <p class="step__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
              {i === 0 && <span class="step__art"><span class="step__art-inner"><Capsule id="step-cap" /></span></span>}
            </p>
            <h3>{item.title}</h3>
            <p class="step__body">{item.body}</p>
          </li>
        ))}
      </ol>
      <div class="ed-aside label-note" data-reveal><Icon name="info" /><div class="prose" set:html={md(directions.body)} /></div>
    </div>
  </section>

  <!-- 3 · Why gluten-free: the client document's question as its own section (client direction 2026-11-28). A
       packshot fills the stage beside the copy (client direction 2026-11-28, later the same day): two bottles on a
       matte white surface, the front one carrying the official cutout, capsules in front. Without that photograph
       (removed in the CMS) the stage falls back to the official bottle cutout alone on the label's pale ground. -->
  {composition.gluten && (
    <section class="section p-sec gluten" id="gluten-free" aria-labelledby="gluten-title">
      <div class="wrap ed-split ed-split--center">
        <div class:list={['ed-split__a', 'gluten__stage', glutenPhoto && 'gluten__stage--photo']} data-reveal>
          {glutenPhoto
            ? <Photo photo={glutenPhoto} variant="portrait" sizes="(min-width: 64rem) 520px, 92vw" />
            : <img src="/img/bottle-560.webp" srcset="/img/bottle-360.webp 360w, /img/bottle-560.webp 560w, /img/bottle-820.webp 820w" sizes="(min-width: 64rem) 260px, 40vw" width="895" height="1713" alt={intro.image_alt} loading="lazy" decoding="async" />}
        </div>
        <div class="p-copy ed-split__b" data-reveal>
          <p class="ed-num" set:html={num(3)} />
          <h2 id="gluten-title" class="ed-title">{glutenHeading}</h2>
          <div class="prose" set:html={md(glutenBody)} />
        </div>
      </div>
    </section>
  )}

  <!-- 4 · Before you start, with storage beside it. -->
  <section class="section p-sec cautions-wrap" id="cautions" aria-labelledby="cautions-title">
    <div class="wrap ed-split ed-split--wide">
      <div class="ed-split__a p-copy cautions" data-reveal>
        <p class="ed-num" set:html={num(4)} />
        <h2 id="cautions-title" class="ed-title">{cautions.heading}</h2>
        <div class="prose" set:html={md(cautions.body)} />
      </div>
      <aside class="ed-split__b ed-aside storage" id="storage" data-reveal aria-labelledby="storage-title">
        <h2 id="storage-title">{storage.heading}</h2>
        <div class="prose" set:html={md(storage.body)} />
      </aside>
    </div>
  </section>

  <!-- 5 · Taking this to your doctor: the one dark panel on the page, with the summary note. -->
  <section class="summary" id="summary" aria-labelledby="summary-title">
    <div class="wrap">
      <div class="ed-panel is-dark aurora summary__panel" data-pointer>
        <div class="summary__copy">
          <p class="ed-num" set:html={num(5)} />
          <h2 id="summary-title" class="ed-title" data-split>{summary.heading}</h2>
          <div class="ed-lead" set:html={md(summary.body)} />
          <div class="btn-row">{summary.actions.map((a: any) => <Action action={a} locale={locale} variant="light" />)}</div>
        </div>
        <div class="summary__note" data-reveal><Note locale={locale} state="complete" /></div>
      </div>
    </div>
  </section>

  <ProductDisclaimer locale={locale} />
  <ProBand locale={locale} />
</Base>

<script>
  import '../scripts/product-scenes.js';
</script>

<style>
  /* The product head carries no stripe field (client 2026-11-28): the label's shapes behind the bottle are its only figure. */
  :global(.page-product .page-head.aurora::before) { content: none; }

  .p-sec { padding-block: var(--section) 0; }
  .p-copy { display: grid; gap: var(--s-3); justify-items: start; }
  .p-copy :global(.prose) { max-width: 36rem; }
  .p-amount { margin-block-start: var(--s-2); padding-block-start: var(--s-3); border-block-start: 1px solid var(--line-strong); }

  /* ---- 1 · What's inside: copy beside a tall photograph with floating ingredient cards ---- */
  .p-inside { overflow-x: clip; }
  .p-inside__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); align-items: start; }
  .p-inside__copy { grid-column: 1 / span 6; }
  .p-inside__side { grid-column: 7 / span 6; min-width: 0; align-self: stretch; }
  /* The stage keeps pace with the long composition: sticky while the copy is read. */
  .p-inside__stage { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .p-inside__stage { isolation: isolate; padding-inline-start: clamp(2rem, 5vw, 5rem); padding-block: clamp(2rem, 4vw, 3.5rem) clamp(1rem, 2vw, 2rem); }
  /* The label's stripe blob behind the far top corner, faint (the pattern's dashes). */
  .p-inside__pattern { position: absolute; z-index: -1; inset-inline-end: 0; top: 0; width: 42%; opacity: 0.55; pointer-events: none; }
  .p-inside__pattern svg { display: block; width: 100%; height: auto; overflow: visible; }
  .p-inside__photo :global(.photo) { aspect-ratio: 4 / 5; border-radius: var(--r-m); border-start-start-radius: clamp(5rem, 12vw, 11rem); box-shadow: none; }
  /* The cards float over the photograph's lower start edge, stacked. */
  .ing-cards { position: absolute; z-index: 2; inset-inline-start: 0; bottom: clamp(1.5rem, 4vw, 3.5rem); display: grid; gap: 0.75rem; width: min(78%, 24rem); list-style: none; margin: 0; padding: 0; }
  .ing-card { display: grid; grid-template-columns: auto 1fr; column-gap: 0.9rem; align-items: start; padding: 0.9rem 1.1rem; border-radius: var(--r-m); background: rgba(255, 255, 255, 0.92); border: 1px solid rgba(255, 255, 255, 0.9); box-shadow: 0 24px 50px -24px rgba(27, 42, 90, 0.45); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .ing-card__icon { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 12px; background: var(--sky); }
  .ing-card__icon :global(.capsule) { width: 1.7rem; rotate: -20deg; }
  .ing-card__body { display: grid; gap: 0.3rem; min-width: 0; }
  .ing-card__name { font: 700 1.0625rem/1.3 var(--font-display); color: var(--ink); letter-spacing: -0.01em; }
  .ing-card__note { font-size: 0.9375rem; color: var(--ink-soft); }
  .ing-card__bar { display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: 0.75rem; margin-block-start: 0.35rem; }
  .ing-card__fill { position: relative; height: 0.5rem; border-radius: 999px; background: var(--line); overflow: hidden; }
  .ing-card__fill::after { content: ''; position: absolute; inset: 0; width: var(--w); border-radius: inherit; background: linear-gradient(90deg, var(--blue), var(--cyan)); transform-origin: 0 50%; transform: scaleX(var(--fill, 1)); }
  :global([dir='rtl']) .ing-card__fill::after { transform-origin: 100% 50%; }
  .ing-card__pct { font: 700 0.875rem/1 var(--font-body); color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* ---- 2 · How to take it ---- */
  .directions .wrap { display: grid; gap: var(--s-5); justify-items: start; }
  .directions__photo { width: 100%; }
  .directions__photo :global(.photo) { aspect-ratio: 21 / 9; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); width: 100%; }
  .step { position: relative; display: grid; gap: var(--s-2); align-content: start; padding-block: var(--s-4) var(--s-3); border-block-start: 1px solid var(--line-strong); }
  .step__num { display: flex; align-items: center; gap: var(--s-3); font: 800 clamp(3rem, 2rem + 3vw, 4.75rem)/0.9 var(--font-display); letter-spacing: -0.03em; color: var(--blue-bright); }
  .step__art { display: block; width: 6.5rem; aspect-ratio: 220 / 90; }
  .step__art-inner { display: block; width: 100%; height: 100%; rotate: -20deg; filter: drop-shadow(0 10px 10px rgba(20, 30, 80, 0.25)); }
  .step h3 { max-width: 16ch; font-size: clamp(1.5rem, 1.2rem + 1vw, 2.125rem); line-height: 1.15; letter-spacing: -0.02em; }
  .step__body { color: var(--ink-soft); max-width: 30rem; }
  .label-note { grid-template-columns: auto 1fr; column-gap: var(--s-2); max-width: 46rem; }
  .label-note :global(svg) { width: 1.6rem; height: 1.6rem; color: var(--blue); margin-top: 0.2rem; }
  .label-note :global(.prose) { max-width: none; }

  /* ---- 3 · Why gluten-free ---- */
  /* The stage keeps the label's corner either way: the packshot fills it, or — without a photograph — the official
     cutout alone stands on the label's pale ground with a contact shadow. */
  .gluten__stage { display: grid; place-items: center; aspect-ratio: 4 / 5; border-radius: var(--r-m); border-start-start-radius: clamp(3rem, 6vw, 6rem); background: linear-gradient(160deg, var(--paper-2) 0%, var(--sky) 100%); }
  .gluten__stage img { width: 46%; height: auto; filter: drop-shadow(0 28px 30px rgba(27, 42, 90, 0.28)); }
  .gluten__stage--photo { overflow: hidden; }
  .gluten__stage--photo :global(.photo) { width: 100%; aspect-ratio: 4 / 5; border-radius: inherit; box-shadow: none; }
  .gluten__stage--photo :global(.photo img) { width: 100%; filter: none; }
  .gluten .p-copy :global(.prose) { max-width: 34rem; }
  .gluten .ed-title { max-width: 18ch; }

  /* ---- 4 · Before you start ---- */
  .cautions :global(p:first-child strong) { display: block; max-width: 24ch; font: 500 clamp(1.5rem, 1.2rem + 1vw, 2.25rem)/1.2 var(--font-display); letter-spacing: -0.02em; color: var(--ink); text-wrap: balance; }
  .storage { margin-block-start: clamp(4.5rem, 6vw, 7rem); }

  /* ---- 4 · To the doctor ---- */
  .summary { padding-block: var(--section) 0; }
  .summary__panel { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); align-items: center; }
  .summary__copy { grid-column: 1 / span 6; display: grid; gap: var(--s-3); justify-items: start; }
  .summary__copy .ed-title { color: #fff; }
  .summary__note { grid-column: 8 / span 5; display: flex; justify-content: center; rotate: 3deg; }

  @media (max-width: 63.99rem) {
    .p-inside__copy, .p-inside__side { grid-column: 1 / -1; }
    .p-inside__side { margin-block-start: var(--s-5); max-width: 34rem; }
    .p-inside__stage { position: static; }
    .gluten__stage { max-width: 30rem; order: 1; }
    .steps { grid-template-columns: 1fr; }
    .storage { margin-block-start: 0; }
    .summary__copy, .summary__note { grid-column: 1 / -1; }
    .summary__note { margin-block-start: var(--s-4); }
  }
  @media (max-width: 40rem) {
    /* Phones: the cards sit under the photograph in flow rather than over it. */
    .p-inside__stage { padding-inline-start: 0; padding-block-end: 0; display: grid; gap: var(--s-3); }
    .ing-cards { position: static; width: 100%; }
    .p-inside__photo :global(.photo) { aspect-ratio: 4 / 4; }
  }
</style>
