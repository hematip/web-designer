---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Sources from '../components/Sources.astro';
import Action from '../components/Action.astro';
import ProBand from '../components/ProBand.astro';
import { getPage, section, md, mdInline } from '../lib/content.js';

const { locale, routePath } = Astro.props;
const { data: page, fallback } = getPage(locale, 'science');
const intro = section(page, 'intro');
const closing = section(page, 'closing');
const studies = page.sections.filter((x: any) => x.id.startsWith('study-'));
---
<Base locale={locale} routePath={routePath} title={page.meta_title} description={page.meta_description} fallback={fallback} status={page.status}>
  <PageHead locale={locale} title={intro.heading} body={intro.body} />

  <div class="wrap studies">
    {studies.map((st: any, i: number) => (
      <section class="study" id={st.id} aria-labelledby={`${st.id}-title`}>
        <div class="study__meta">
          <span class="study__num" aria-hidden="true">{i + 1}</span>
          {st.published && <p class="study__pub" set:html={mdInline(st.published)} />}
          <Sources dois={st.sources} locale={locale} />
        </div>
        <div class="study__body">
          <h2 id={`${st.id}-title`}>{st.heading}</h2>
          <div class="prose study__prose" set:html={md(st.body)} />
        </div>
      </section>
    ))}
  </div>

  <section class="honest" aria-labelledby="honest-title">
    <div class="wrap honest__inner">
      <h2 id="honest-title">{closing.heading}</h2>
      <div class="prose lead" set:html={md(closing.body)} />
      <p class="honest__pro">{closing.pro_prompt} <Action action={closing.pro_action} locale={locale} variant="link" /></p>
      <div class="btn-row">{closing.actions.map((a: any) => <Action action={a} locale={locale} />)}</div>
    </div>
  </section>

  <ProBand locale={locale} />
</Base>

<style>
  .studies { padding-block-end: var(--section); }
  .study {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem);
    padding-block: var(--s-6); border-top: 1px solid var(--line);
  }
  .study__meta { grid-column: 1 / span 4; display: grid; gap: var(--s-2); align-content: start; }
  .study__num {
    display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%;
    border: 2px solid var(--royal); color: var(--royal); font: 600 1.625rem/1 var(--font-display);
  }
  .study__pub { font-weight: 700; }
  .study__body { grid-column: 6 / span 7; display: grid; gap: var(--s-3); }
  .study__prose :global(strong) {
    font-family: var(--font-display); font-weight: 700; color: var(--royal); font-size: 1.15em;
    background: linear-gradient(transparent 60%, var(--cream) 60%); padding-inline: 0.06em;
  }
  .honest { background: var(--mist); }
  .honest__inner { display: grid; gap: var(--s-3); justify-items: start; padding-block: var(--section); }
  .honest__pro { font-size: var(--fs-body); }
  @media (max-width: 63.99rem) {
    .study__meta, .study__body { grid-column: 1 / -1; }
    .study__body { margin-block-start: var(--s-3); }
    .study__meta { grid-template-columns: auto 1fr; align-items: center; }
    .study__meta :global(.sources) { grid-column: 1 / -1; }
  }
</style>
