---
// The five groups, in the home page's language (2026-11-25): a sticky index beside numbered open entries parted by
// hairlines; the photograph takes the label's corner. Copy unchanged.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Sources from '../components/Sources.astro';
import Pending from '../components/Pending.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import ProductDisclaimer from '../components/ProductDisclaimer.astro';
import ProBand from '../components/ProBand.astro';
import Photo from '../components/Photo.astro';
import { getPage, getSite, section, md, photoOf } from '../lib/content.js';

const { locale, routePath } = Astro.props;
const { data: page, fallback } = getPage(locale, 'who-its-for');
const site = getSite(locale).data;
const ui = site.ui;
const navLabel = site.nav.find((n: any) => n.href === '/who-its-for')?.label;
const intro = section(page, 'intro');
const closing = section(page, 'closing');
const groups = page.sections.filter((x: any) => !['intro', 'closing'].includes(x.id));
const photo = photoOf(locale, 'who-its-for', 'intro');
---
<Base locale={locale} routePath={routePath} title={page.meta_title} description={page.meta_description} fallback={fallback} status={page.status}>
  <PageHead locale={locale} title={intro.heading} body={intro.body} accent="Memowell®" kicker={navLabel}>
    {photo && <Photo slot="media" photo={photo} variant="portrait" sizes="(min-width: 64rem) 34vw, 92vw" eager />}
  </PageHead>

  <div class="wrap ed-split ed-split--narrow groups">
    <nav class="ed-split__a ed-index ed-index--sticky" aria-labelledby="otp-title">
      <p id="otp-title" class="ed-index__title">{ui.on_this_page}</p>
      <ol role="list">
        {groups.map((g: any, i: number) => (
          <li><a href={`#${g.id}`}><span class="idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{g.heading}</a></li>
        ))}
      </ol>
    </nav>

    <div class="ed-split__b ed-entries">
      {groups.map((g: any, i: number) => (
        <section class="ed-entry group" data-reveal id={g.id} aria-labelledby={`${g.id}-title`}>
          <p class="ed-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}<span> / {String(groups.length).padStart(2, '0')}</span></p>
          <h2 id={`${g.id}-title`}>{g.heading}</h2>
          <div class="prose" set:html={md(g.body)} />
          {g.pending === 'mid-life-dose' && (
            <Pending label="mid-life dose unconfirmed" detail="Catalogue says one capsule daily; client ruling says three times a day. The line stays attributed to the catalogue until the client / scientific officer confirms (brief Part 9)." />
          )}
          <Sources dois={g.sources} locale={locale} />
        </section>
      ))}
    </div>
  </div>

  <ClosingCTA locale={locale} heading={closing.heading} body={closing.body} actions={closing.actions} tone={closing.tone} />
  <ProductDisclaimer locale={locale} />
  <ProBand locale={locale} />
</Base>

<style>
  .groups { padding-block: var(--section) 0; }
  .group:first-child { border-block-start: 0; padding-block-start: 0; }
  .group h2 { max-width: 20ch; }
  .group :global(.prose) { max-width: 40rem; }
  @media (max-width: 63.99rem) {
    .groups :global(.ed-index) { margin-block-end: var(--s-2); }
  }
</style>
