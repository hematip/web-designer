---
// Blog index in the home page's language (2026-11-25): the photograph takes the label's corner; articles are open
// entries on hairlines in a three-column grid, each with its category as a kicker.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ProBand from '../components/ProBand.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { getPage, getSite, section, href, getArticlesWithFallback, fill, IS_PREVIEW, photoOf } from '../lib/content.js';

const { locale, routePath, pageNumber = 1, category } = Astro.props;
const { data: page, fallback } = getPage(locale, 'memory-health');
const site = getSite(locale).data;
const ui = site.ui;
const navLabel = site.nav.find((n: any) => n.href === '/memory-health')?.label;
const intro = section(page, 'intro');
const photo = photoOf(locale, 'memory-health', 'intro');
const cats = page.categories ?? [];
const catLabel = (slug: string) => cats.find((c: any) => c.slug === slug)?.label ?? slug;
const size = page.page_size ?? 6;
const { list: all } = getArticlesWithFallback(locale);
const list = category ? all.filter((a: any) => a.category === category) : all;
const total = Math.max(1, Math.ceil(list.length / size));
const items = list.slice((pageNumber - 1) * size, pageNumber * size);
const base = category ? `/memory-health/category/${category}` : '/memory-health';
const pageHref = (n: number) => href(locale, n === 1 ? base : `${base}/page/${n}`);
const title = category ? `${catLabel(category)} — ${page.meta_title}` : pageNumber > 1 ? `${page.meta_title} (${fill(ui.page_of, { n: pageNumber, total })})` : page.meta_title;
---
<Base locale={locale} routePath={routePath} title={title} description={page.meta_description} fallback={fallback} status={page.status}>
  <PageHead locale={locale} title={intro.heading} body={intro.body} kicker={navLabel}>
    {photo && <Photo slot="media" photo={photo} variant="portrait" sizes="(min-width: 64rem) 34vw, 92vw" eager />}
    <nav class="cats" aria-label={intro.categories_label}>
      <p class="ed-kicker cats__label">{intro.categories_label}</p>
      <ul role="list">
        <li><a href={href(locale, '/memory-health')} aria-current={!category ? 'page' : undefined}>{ui.all_articles}</a></li>
        {cats.map((c: any) => (
          <li><a href={href(locale, `/memory-health/category/${c.slug}`)} aria-current={category === c.slug ? 'page' : undefined}>{c.label}</a></li>
        ))}
      </ul>
    </nav>
  </PageHead>

  <section class="wrap articles" aria-label={category ? catLabel(category) : ui.all_articles}>
    {items.length === 0 ? (
      <p class="empty ed-pull" data-reveal>{ui.no_articles}</p>
    ) : (
      <ul class="article-grid" role="list">
        {items.map((a: any) => (
          <li class="article-card ed-entry" data-reveal>
            <p class="ed-kicker article-card__cat">{catLabel(a.category)}</p>
            <h2 class="article-card__title"><a href={href(locale, `/memory-health/${a.slug}`)}>{a.title}</a></h2>
            {a.summary && <p class="article-card__summary">{a.summary}</p>}
            {a.published && <p class="article-card__date small muted">{ui.published} <time datetime={a.published}>{a.published}</time></p>}
            <span class="article-card__arrow" aria-hidden="true"><Icon name="arrow" /></span>
            {IS_PREVIEW && a.status !== 'approved' && <span class="pending small">Draft — needs scientific approval</span>}
          </li>
        ))}
      </ul>
    )}

    {total > 1 && (
      <nav class="pager" aria-label={fill(ui.page_of, { n: pageNumber, total })}>
        {pageNumber > 1 ? <a class="btn btn--secondary" href={pageHref(pageNumber - 1)} rel="prev"><span>{ui.previous}</span></a> : <span />}
        <p>{fill(ui.page_of, { n: pageNumber, total })}</p>
        {pageNumber < total ? <a class="btn btn--secondary" href={pageHref(pageNumber + 1)} rel="next"><span>{ui.next}</span><Icon name="arrow" class="arrow" /></a> : <span />}
      </nav>
    )}
  </section>

  <ProBand locale={locale} />
</Base>

<style>
  .cats { margin-block-start: var(--s-4); }
  .cats__label { color: var(--cyan-stripe); margin-block-end: var(--s-2); }
  .cats ul { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .cats a { display: inline-flex; align-items: center; min-height: 3rem; padding: 0.5rem 1.15rem; border-radius: 999px; background: var(--glass); border: 1px solid var(--glass-line); color: #fff; text-decoration: none; font-weight: 700; font-size: 1.0625rem; }
  .cats a:hover { background: rgba(255, 255, 255, 0.16); color: #fff; }
  .cats a[aria-current='page'] { background: #fff; border-color: #fff; color: var(--navy); }
  .articles { padding-block: var(--section) 0; }
  .article-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: clamp(1rem, 2.5vw, 2.5rem); }
  .article-card { gap: var(--s-2); align-content: start; padding-block: var(--s-4) var(--s-5); min-height: 20rem; }
  .article-card__title { max-width: none; font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.75rem); line-height: 1.18; }
  .article-card__title a { color: var(--ink); text-decoration: none; }
  .article-card__title a::after { content: ''; position: absolute; inset: 0; }
  .article-card:hover .article-card__title a { color: var(--blue-bright); }
  .article-card__title a:focus-visible { outline: none; }
  .article-card:has(a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; border-radius: 6px; }
  .article-card__summary { color: var(--ink-soft); }
  .article-card__arrow { position: absolute; inset-inline-end: 0; top: var(--s-4); display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1px solid var(--line-strong); color: var(--ink); transition: transform 0.35s var(--ease-out), background-color 0.25s var(--ease), color 0.25s var(--ease); }
  .article-card__arrow :global(svg) { width: 1.1rem; height: 1.1rem; }
  :global([dir='rtl']) .article-card__arrow :global(svg) { transform: scaleX(-1); }
  .article-card:hover .article-card__arrow { background: var(--navy); color: #fff; border-color: var(--navy); transform: translateX(3px); }
  .article-card .pending { position: relative; z-index: 1; }
  .empty { padding-block-start: var(--s-4); border-block-start: 1px solid var(--line-strong); }
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--s-2); margin-block-start: var(--s-5); }
  .pager p { font-weight: 700; }
  .pager a[rel='next'] { justify-self: end; }
  @media (max-width: 63.99rem) { .article-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .article-grid { grid-template-columns: 1fr; } .article-card { min-height: 0; } }
</style>
