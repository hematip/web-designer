---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ProBand from '../components/ProBand.astro';
import Icon from '../components/Icon.astro';
import { getPage, getSite, section, href, getArticlesWithFallback, fill, IS_PREVIEW } from '../lib/content.js';

const { locale, routePath, pageNumber = 1, category } = Astro.props;
const { data: page, fallback } = getPage(locale, 'memory-health');
const ui = getSite(locale).data.ui;
const intro = section(page, 'intro');
const cats = page.categories ?? [];
const catLabel = (slug: string) => cats.find((c: any) => c.slug === slug)?.label ?? slug;
const size = page.page_size ?? 6;
const { list: all } = getArticlesWithFallback(locale);
const list = category ? all.filter((a: any) => a.category === category) : all;
const total = Math.max(1, Math.ceil(list.length / size));
const items = list.slice((pageNumber - 1) * size, pageNumber * size);
const base = category ? `/memory-health/category/${category}` : '/memory-health';
const pageHref = (n: number) => href(locale, n === 1 ? base : `${base}/page/${n}`);
const title = category ? `${catLabel(category)} — ${page.meta_title}` : pageNumber > 1 ? `${page.meta_title} (${fill(ui.page_of, { n: pageNumber, total })})` : page.meta_title;
---
<Base locale={locale} routePath={routePath} title={title} description={page.meta_description} fallback={fallback} status={page.status}>
  <PageHead locale={locale} title={intro.heading} body={intro.body}>
    <nav class="cats" aria-label={intro.categories_label}>
      <p class="cats__label">{intro.categories_label}</p>
      <ul role="list">
        <li><a href={href(locale, '/memory-health')} aria-current={!category ? 'page' : undefined}>{ui.all_articles}</a></li>
        {cats.map((c: any) => (
          <li><a href={href(locale, `/memory-health/category/${c.slug}`)} aria-current={category === c.slug ? 'page' : undefined}>{c.label}</a></li>
        ))}
      </ul>
    </nav>
  </PageHead>

  <section class="wrap articles" aria-label={category ? catLabel(category) : ui.all_articles}>
    {items.length === 0 ? (
      <p class="empty">{ui.no_articles}</p>
    ) : (
      <ul class="article-grid" role="list">
        {items.map((a: any) => (
          <li class="article-card">
            <p class="article-card__cat">{catLabel(a.category)}</p>
            <h2 class="article-card__title"><a href={href(locale, `/memory-health/${a.slug}`)}>{a.title}</a></h2>
            {a.summary && <p class="article-card__summary">{a.summary}</p>}
            {a.published && <p class="article-card__date small muted">{ui.published} <time datetime={a.published}>{a.published}</time></p>}
            {IS_PREVIEW && a.status !== 'approved' && <span class="pending small">Draft — body not written; needs scientific approval</span>}
          </li>
        ))}
      </ul>
    )}

    {total > 1 && (
      <nav class="pager" aria-label={fill(ui.page_of, { n: pageNumber, total })}>
        {pageNumber > 1 ? <a class="btn btn--secondary" href={pageHref(pageNumber - 1)} rel="prev"><span>{ui.previous}</span></a> : <span />}
        <p>{fill(ui.page_of, { n: pageNumber, total })}</p>
        {pageNumber < total ? <a class="btn btn--secondary" href={pageHref(pageNumber + 1)} rel="next"><span>{ui.next}</span><Icon name="arrow" class="arrow" /></a> : <span />}
      </nav>
    )}
  </section>

  <ProBand locale={locale} />
</Base>

<style>
  .cats { margin-block-start: var(--s-4); }
  .cats__label { font-weight: 700; color: var(--ink-soft); margin-block-end: var(--s-1); }
  .cats ul { display: flex; flex-wrap: wrap; gap: var(--s-1); }
  .cats a {
    display: inline-flex; align-items: center; min-height: 3rem; padding: 0.5rem 1.1rem; border-radius: 999px;
    border: 2px solid var(--line-strong); color: var(--ink); text-decoration: none; font-weight: 700; font-size: 1.0625rem;
  }
  .cats a:hover { border-color: var(--royal); color: var(--royal); }
  .cats a[aria-current='page'] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .articles { padding-block-end: var(--section); }
  .article-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: var(--s-3); }
  .article-card {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-m); padding: var(--s-4) var(--s-3);
    display: grid; gap: var(--s-2); align-content: start; position: relative;
  }
  .article-card:hover { border-color: var(--royal); }
  .article-card__cat { font-weight: 700; font-size: var(--fs-small); color: var(--royal); }
  .article-card__title { font-size: var(--fs-h3); line-height: 1.3; }
  .article-card__title a { color: var(--ink); text-decoration: none; }
  .article-card__title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .article-card__title a:hover { text-decoration: underline; }
  .article-card__title a:focus-visible { outline: none; }
  .article-card:has(a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  .article-card .pending { position: relative; z-index: 1; }
  .empty { font-size: var(--fs-lead); color: var(--ink-soft); padding: var(--s-5) var(--s-4); border: 2px dashed var(--line-strong); border-radius: var(--radius-m); max-width: 44rem; }
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--s-2); margin-block-start: var(--s-5); }
  .pager p { font-weight: 700; }
  .pager a[rel='next'] { justify-self: end; }
</style>
