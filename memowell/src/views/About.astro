---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Action from '../components/Action.astro';
import ProBand from '../components/ProBand.astro';
import { getPage, section, md, settings } from '../lib/content.js';

const { locale, routePath } = Astro.props;
const { data: page, fallback } = getPage(locale, 'about');
const intro = section(page, 'intro');
const products = section(page, 'products');
---
<Base locale={locale} routePath={routePath} title={page.meta_title} description={page.meta_description} fallback={fallback} status={page.status}>
  <PageHead locale={locale} title={intro.heading} body={intro.body}>
    <div class="btn-row about-actions">{intro.actions.map((a: any) => <Action action={a} locale={locale} />)}</div>
    <div slot="media" class="kondor-mark">
      <img src="/brand/kondor-pharma-logo.png" width="420" height="185" alt="Kondor Pharma" />
    </div>
  </PageHead>

  <section class="section other" aria-labelledby="other-title">
    <div class="wrap">
      <h2 id="other-title" data-split>{products.heading}</h2>
      <ul class="products" role="list">
        {products.items.map((p: any) => (
          <li data-reveal><a class="product-link" href={settings.kondor_url} rel="noopener"><strong>{p.title}</strong></a></li>
        ))}
      </ul>
      <div class="prose" set:html={md(products.body)} />
    </div>
  </section>

  <ProBand locale={locale} />
</Base>

<style>
  .about-actions { margin-block-start: var(--s-4); }
  .kondor-mark { background: #fff; border-radius: var(--r-xl); padding: clamp(2rem, 4vw, 4rem); display: grid; place-items: center; box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6); rotate: -3deg; }
  .kondor-mark img { width: min(100%, 20rem); }
  .other .wrap { display: grid; gap: var(--s-4); }
  .products { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); }
  .product-link {
    position: relative; overflow: hidden; isolation: isolate; display: flex; align-items: flex-end; min-height: 12rem; padding: var(--s-4);
    border-radius: var(--r-xl); background: #fff; border: 1px solid var(--line); color: var(--ink); text-decoration: none;
    font: 700 clamp(1.75rem, 1.3rem + 1.5vw, 2.75rem)/1 var(--font-display); letter-spacing: -0.04em; transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }
  .product-link::before { content: ''; position: absolute; z-index: -1; width: 14rem; height: 14rem; inset-inline-end: -4rem; top: -5rem; border-radius: 50%; background: radial-gradient(circle, rgba(76, 99, 255, 0.25), transparent 70%); }
  .product-link strong { font-weight: 700; }
  .product-link:hover { transform: translateY(-6px); box-shadow: var(--shadow-soft); color: var(--royal); }
  @media (max-width: 47.99rem) { .products { grid-template-columns: 1fr; } }
</style>
