---
// Target of "Read the five case reports": the five cases of the client's product document, as written
// (client direction 2026-11-21), under the page's warning paragraph. Open entries on hairlines (2026-11-25).
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getPage, getSite, section, md } from '../lib/content.js';

const { locale, routePath } = Astro.props;
const { data: page, fallback } = getPage(locale, 'case-reports');
const nav = getSite(locale).data.nav;
const science = nav.find((n: any) => n.href === '/science');
const crumbs = [{ label: science?.label ?? 'Science', href: '/science' }];
const intro = section(page, 'intro');
const reports = section(page, 'reports');
---
<Base locale={locale} routePath={routePath} title={page.meta_title} fallback={fallback} status={page.status}>
  <PageHead locale={locale} title={intro.heading} body={intro.body} crumbs={crumbs} kicker={science?.label} />
  <section class="wrap cases ed-entries">
    {(reports.items ?? []).length === 0
      ? <p class="pending"><strong>Awaiting approved English text from the scientific officer.</strong> The five case reports exist only as the client's Persian catalogue summaries, written as success stories; they are not published.</p>
      : (reports.items.map((r: any, i: number) => (
        <article class="ed-entry case" data-reveal>
          <p class="ed-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}<span> / {String(reports.items.length).padStart(2, '0')}</span></p>
          <div class="prose" set:html={md(r.body)} />
        </article>
      )))}
  </section>
</Base>
<style>
  .cases { padding-block: var(--section); }
  .case :global(.prose) { max-width: 52rem; font-size: var(--fs-lead); line-height: 1.55; }
  .case :global(.prose strong) { font-family: var(--font-display); font-size: var(--fs-h3); }
  .case:first-child { border-block-start: 0; padding-block-start: 0; }
</style>
